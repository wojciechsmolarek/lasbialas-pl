---
import { SEO } from 'astro-seo';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import '../styles/global.css';
import lasbialas8 from '../assets/foto/lasbialas8.webp';
import { minStayRules, jacuzziNoticePeriods } from '../data/minStayRules';

interface Props {
  title: string;
  description: string;
  lang?: 'pl' | 'en' | 'de';
  canonical?: string;
  ogImage?: string;
  isHomePage?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'pl',
  canonical,
  ogImage = lasbialas8.src,
  isHomePage = false,
  noindex = false
} = Astro.props;

const siteUrl = 'https://lasbialas.pl';

// Clean pathname: strip .html extension (from build.format: 'file'), normalize /index.html to /,
// and drop the trailing slash (the server redirects /page/ to /page)
const cleanPathname = (Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '')
  .replace(/(.)\/$/, '$1')) || '/';

const canonicalUrl = canonical || `${siteUrl}${cleanPathname}`;

// Hreflang: odpowiedniki tej samej strony w każdym języku.
// Nową podstronę z wersjami językowymi dopisz tutaj jako kolejną grupę.
const alternateGroups: Record<'pl' | 'en' | 'de', string>[] = [
  { pl: '/', en: '/en', de: '/de' },
  { pl: '/opinie', en: '/en/reviews', de: '/de/bewertungen' },
  { pl: '/regulamin', en: '/en/terms-and-conditions', de: '/de/hausordnung' },
  { pl: '/polityka-prywatnosci', en: '/en/privacy-policy', de: '/de/datenschutzerklarung' },
  { pl: '/rodo', en: '/en/rodo', de: '/de/rodo' },
];
const group = alternateGroups.find((g) => Object.values(g).includes(cleanPathname));
const toUrl = (path: string) => (path === '/' ? `${siteUrl}/` : `${siteUrl}${path}`);
const hreflangs = group
  ? [
      { lang: 'pl', url: toUrl(group.pl) },
      { lang: 'en', url: toUrl(group.en) },
      { lang: 'de', url: toUrl(group.de) },
      { lang: 'x-default', url: toUrl(group.pl) },
    ]
  : [];

const ogLocale = { pl: 'pl_PL', en: 'en_GB', de: 'de_DE' }[lang];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />

    <style is:inline>
      @font-face{font-display:optional;font-family:Montserrat;font-style:normal;font-weight:200;src:url(/fonts/Montserrat-Light-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
      @font-face{font-display:optional;font-family:Montserrat;font-style:normal;font-weight:200;src:url(/fonts/Montserrat-Light-latin-ext.woff2) format('woff2');unicode-range:U+0100-024F,U+0259,U+1E00-1EFF}
      @font-face{font-display:optional;font-family:Montserrat;font-style:normal;font-weight:400;src:url(/fonts/Montserrat-Regular-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
      @font-face{font-display:optional;font-family:Montserrat;font-style:normal;font-weight:400;src:url(/fonts/Montserrat-Regular-latin-ext.woff2) format('woff2');unicode-range:U+0100-024F,U+0259,U+1E00-1EFF}
      @font-face{font-display:optional;font-family:Montserrat;font-style:normal;font-weight:600;src:url(/fonts/Montserrat-SemiBold-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
      @font-face{font-display:optional;font-family:Montserrat;font-style:normal;font-weight:600;src:url(/fonts/Montserrat-SemiBold-latin-ext.woff2) format('woff2');unicode-range:U+0100-024F,U+0259,U+1E00-1EFF}
    </style>

    <!-- Preload critical font (Light-Latin only, needed for font-display: optional) -->
    <link rel="preload" href="/fonts/Montserrat-Light-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- DNS prefetch for external domains (lazy-loaded, not critical) -->
    <link rel="dns-prefetch" href="https://cdn.bookero.pl" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://collect.yabrix.com" />

    <SEO
      title={title}
      description={description}
      canonical={canonicalUrl}
      noindex={noindex}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: `${siteUrl}${ogImage}`,
          url: canonicalUrl
        },
        optional: {
          description: description,
          locale: ogLocale,
          siteName: "Las Biala's"
        },
        image: {
          width: 1200,
          height: 1200
        }
      }}
    />

    <!-- Hreflang -->
    {hreflangs.map(({ lang: hreflangLang, url }) => (
      <link rel="alternate" hreflang={hreflangLang} href={url} />
    ))}

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <!-- Schema.org Structured Data - only on the home page (FAQ and offers are shown there) -->
    {isHomePage && <SchemaOrg lang={lang} />}

    <!-- Yabrix Analytics (Lazy Load to avoid forced reflow) -->
    <script is:inline>
      (function() {
        function loadYabrix() {
          var s = document.createElement('script');
          s.src = 'https://collect.yabrix.com/js/yabrix.min.js';
          s.setAttribute('data-yx', '1f3667d27b92c8b9');
          s.async = true;
          document.body.appendChild(s);
        }
        window.addEventListener('scroll', loadYabrix, { once: true, passive: true });
        window.addEventListener('mousemove', loadYabrix, { once: true });
        window.addEventListener('touchstart', loadYabrix, { once: true, passive: true });
        setTimeout(loadYabrix, 5000);
      })();
    </script>

    <!-- Google Analytics: ładowany wyłącznie po zgodzie na cookies, w CookieConsent.astro -->

    <!-- Bookero Reservation System -->
    <script is:inline define:vars={{ lang }}>
      // Bookero configuration
      window.bookero_config = {
        id: 'WmRe79H4lKFz',
        container: 'bookero',
        type: 'sticky',
        position: 'bottom-right',
        plugin_css: true,
        lang: lang
      };

      var bookeroLoaded = false;
      var bookeroPendingClick = false;

      function loadBookeroScript() {
        if (bookeroLoaded) return;
        bookeroLoaded = true;
        var d = document, s = d.createElement('script');
        s.src = 'https://cdn.bookero.pl/plugin/v2/js/bookero-compiled.js';
        s.onload = function() {
          // Hide fallback button once Bookero loads its own toggle
          var fallback = document.getElementById('bookero-sticky-fallback');
          if (fallback) fallback.style.display = 'none';
          if (bookeroPendingClick) {
            bookeroPendingClick = false;
            setTimeout(function() {
              if (typeof window.bookero_open === 'function') {
                window.bookero_open();
              } else {
                var toggle = document.querySelector('.bookero-sticky-plugin-toggle');
                if (toggle) toggle.click();
              }
              // Enforce minimum 2 nights after plugin opens
              if (typeof window.enforceBookeroMinDays === 'function') {
                window.enforceBookeroMinDays();
              }
            }, 200);
          }
        };
        d.body.appendChild(s);
      }

      // Only load on user interaction, not on page load
      window.openReservation = function() {
        if (bookeroLoaded) {
          if (typeof window.bookero_open === 'function') {
            window.bookero_open();
            if (typeof window.enforceBookeroMinDays === 'function') window.enforceBookeroMinDays();
            return;
          }
          if (window.Bookero && window.Bookero.API && typeof window.Bookero.API.openCalendar === 'function') {
            window.Bookero.API.openCalendar();
            if (typeof window.enforceBookeroMinDays === 'function') window.enforceBookeroMinDays();
            return;
          }
          var toggle = document.querySelector('.bookero-sticky-plugin-toggle');
          if (toggle) toggle.click();
          if (typeof window.enforceBookeroMinDays === 'function') window.enforceBookeroMinDays();
        } else {
          bookeroPendingClick = true;
          loadBookeroScript();
        }
      };
    </script>

    <!-- Enforce full-width Bookero toggle on mobile after plugin closes -->
    <script is:inline>
      (function() {
        function enforceMobileToggle() {
          if (window.innerWidth > 960) return;
          var toggle = document.querySelector('.bookero-sticky-plugin-toggle');
          if (!toggle) return;
          toggle.style.setProperty('width', '100vw', 'important');
          toggle.style.setProperty('max-width', '100vw', 'important');
          toggle.style.setProperty('height', '60px', 'important');
          toggle.style.setProperty('left', '0', 'important');
          toggle.style.setProperty('right', '0', 'important');
          toggle.style.setProperty('bottom', '0', 'important');
          toggle.style.setProperty('top', 'auto', 'important');
          toggle.style.setProperty('margin', '0', 'important');
          toggle.style.setProperty('border-radius', '0', 'important');
          toggle.style.setProperty('transform', 'none', 'important');
        }

        function initObserver() {
          var plugin = document.getElementById('bookero-plugin');
          if (!plugin) {
            setTimeout(initObserver, 500);
            return;
          }
          var toggle = plugin.querySelector('.bookero-sticky-plugin-toggle');
          if (!toggle) {
            setTimeout(initObserver, 500);
            return;
          }
          enforceMobileToggle();
          var observer = new MutationObserver(function() {
            enforceMobileToggle();
          });
          observer.observe(toggle, { attributes: true, attributeFilter: ['style', 'class'] });
        }

        document.addEventListener('bookero-plugin:loaded', function() {
          setTimeout(initObserver, 300);
        });
        if (document.readyState !== 'loading') {
          setTimeout(initObserver, 1000);
        } else {
          document.addEventListener('DOMContentLoaded', function() {
            setTimeout(initObserver, 1000);
          });
        }
      })();
    </script>

    <!-- Reguły formularza w wybranych terminach (src/data/minStayRules.ts):
         1) minimalny pobyt: komunikat pod kalendarzem i blokada przejścia dalej, gdy pobyt jest za krótki;
         2) jacuzzi zimą: komunikat informacyjny pod polem jacuzzi (bez blokady). -->
    <script is:inline define:vars={{ minStayRules, jacuzziNoticePeriods, lang }}>
      (function () {
        var DAY = 86400000;
        function toUTC(s) { var p = s.split('-'); return Date.UTC(+p[0], +p[1] - 1, +p[2]); }
        var rules = minStayRules.map(function (r) { return { from: toUTC(r.from), to: toUTC(r.to), min: r.minNights }; });
        var jacuzziPeriods = jacuzziNoticePeriods.map(function (r) { return { from: toUTC(r.from), to: toUTC(r.to) }; });
        if (!rules.length && !jacuzziPeriods.length) return;

        // Miesiące z nagłówka kalendarza Bookero (PL / EN / DE), po pierwszych 3 literach.
        var MONTHS = { sty:0, jan:0, lut:1, feb:1, mar:2, 'mär':2, kwi:3, apr:3, maj:4, may:4, mai:4, cze:5, jun:5,
          lip:6, jul:6, sie:7, aug:7, wrz:8, sep:8, 'paź':9, oct:9, okt:9, lis:10, nov:10, gru:11, dec:11, dez:11 };

        var BOX_STYLE = 'margin:12px 0;padding:10px 14px;border-left:4px solid #B5550E;background:#FBEFE6;color:#272727;font-size:14px;line-height:1.5;border-radius:5px;';
        var LINK_STYLE = 'color:#2F6940;font-weight:600;text-decoration:underline;';
        var TEL = '<a href="tel:+48789773285" style="' + LINK_STYLE + '">';
        var WA = '<a href="https://wa.me/48660194187" target="_blank" rel="noopener" style="' + LINK_STYLE + '">';

        function dd(t) { var d = new Date(t); return ('0' + d.getUTCDate()).slice(-2) + '.' + ('0' + (d.getUTCMonth() + 1)).slice(-2); }
        function nightsPl(n) { var l = n % 10, t = n % 100; return (l >= 2 && l <= 4 && (t < 12 || t > 14)) ? 'doby' : 'dób'; }
        function minStayText(rule) {
          var a = dd(rule.from), b = dd(rule.to), n = rule.min;
          if (lang === 'en') return 'Between ' + a + ' and ' + b + ' the minimum stay is ' + n + ' nights. Please increase the number of nights or choose other dates.';
          if (lang === 'de') return 'Im Zeitraum ' + a + '.–' + b + '. beträgt der Mindestaufenthalt ' + n + ' Nächte. Bitte erhöhen Sie die Anzahl der Nächte oder wählen Sie einen anderen Zeitraum.';
          return 'W okresie ' + a + '–' + b + ' minimalny pobyt to ' + n + ' ' + nightsPl(n) + '. Zwiększ liczbę dób albo wybierz inny termin.';
        }
        // Jacuzzi zimą: spokojna informacja (żółte tło, ikona „i”), nie ostrzeżenie. Rezerwacji nie wstrzymuje.
        var INFO_STYLE = 'margin:12px 0;padding:10px 14px;border-left:4px solid #D4A72C;background:#FFF8E1;color:#272727;font-size:14px;line-height:1.5;border-radius:5px;';
        var INFO_ICON = '<span aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;margin-right:6px;border-radius:50%;background:#D4A72C;color:#fff;font-size:12px;font-weight:700;vertical-align:-3px;">i</span>';
        function jacuzziHtml() {
          if (lang === 'en') return INFO_ICON + '<strong>Good to know:</strong> if there is severe or prolonged frost during your stay, the jacuzzi may be temporarily unavailable. You can complete your booking as usual, and we will confirm jacuzzi availability before your arrival. Questions: phone ' + TEL + '+48 789 773 285</a>, WhatsApp ' + WA + '+48 660 194 187</a>.';
          if (lang === 'de') return INFO_ICON + '<strong>Gut zu wissen:</strong> Sollte während Ihres Aufenthalts starker oder anhaltender Frost herrschen, kann der Whirlpool vorübergehend nicht verfügbar sein. Sie können Ihre Buchung wie gewohnt abschließen, die Verfügbarkeit des Whirlpools bestätigen wir vor Ihrer Anreise. Fragen: Tel. ' + TEL + '+48 789 773 285</a>, WhatsApp ' + WA + '+48 660 194 187</a>.';
          return INFO_ICON + '<strong>Dobrze wiedzieć:</strong> jeśli w terminie Twojego pobytu wystąpią silne lub długotrwałe mrozy, jacuzzi może być czasowo niedostępne. Rezerwację możesz złożyć normalnie, a dostępność jacuzzi potwierdzimy przed Twoim przyjazdem. Pytania: tel. ' + TEL + '789 773 285</a>, WhatsApp ' + WA + '660 194 187</a>.';
        }

        // Dopisek do pola „Uwagi”, zapisywany w rezerwacji, gdy jacuzzi jest rezerwowane warunkowo.
        var NOTE = {
          pl: 'Jacuzzi rezerwowane warunkowo: przy silnych lub długotrwałych mrozach może być niedostępne, dostępność zostanie potwierdzona przed przyjazdem.',
          en: 'Jacuzzi booked conditionally: may be unavailable during severe or prolonged frost, availability will be confirmed before arrival.',
          de: 'Whirlpool unter Vorbehalt gebucht: bei starkem oder anhaltendem Frost möglicherweise nicht verfügbar, die Verfügbarkeit wird vor der Anreise bestätigt.'
        };
        var NOTE_PREFIXES = ['Jacuzzi rezerwowane warunkowo', 'Jacuzzi booked conditionally', 'Whirlpool unter Vorbehalt gebucht'];
        function syncNote(show) {
          var ta = document.querySelector('#bookero-plugin .params-section textarea') || document.querySelector('#bookero-plugin .field textarea');
          if (!ta || document.activeElement === ta) return; // nie ruszamy pola, gdy gość w nim pisze
          var kept = ta.value.split('\n').filter(function (l) {
            return !NOTE_PREFIXES.some(function (p) { return l.trim().indexOf(p) === 0; });
          });
          while (kept.length && kept[kept.length - 1].trim() === '') kept.pop();
          if (show) kept.push(NOTE[lang] || NOTE.pl);
          var value = kept.join('\n');
          if (value !== ta.value) {
            ta.value = value;
            ta.dispatchEvent(new Event('input', { bubbles: true })); // Bookero zapisuje zmianę w formularzu
          }
        }

        var arrival = null; // ostatnio wybrana data przyjazdu (UTC)
        var violated = null;

        function readArrival() {
          var cell = document.querySelector('#bookero-plugin .calendar-days-list-cell.is-selected:not(.is-offset)');
          var nav = document.querySelector('#bookero-plugin .calendar-nav-month');
          if (!cell || !nav) return;
          var day = parseInt(cell.textContent, 10);
          var txt = nav.textContent.trim().toLowerCase();
          var year = parseInt((txt.match(/\d{4}/) || [])[0], 10);
          var month = MONTHS[txt.slice(0, 3)];
          if (day && year && month !== undefined) arrival = Date.UTC(year, month, day);
        }
        function readNights() {
          var el = document.getElementById('bookero-plugin-days-number');
          return el ? (parseInt(el.value, 10) || 0) : 0;
        }
        function overlaps(dep, p) { return arrival < p.to && dep > p.from; }

        // Pole jacuzzi rozpoznajemy po etykiecie (PL/EN: „jacuzzi”, DE: „Whirlpool”).
        function jacuzziField() {
          var labels = document.querySelectorAll('#bookero-plugin .field .label-param');
          for (var i = 0; i < labels.length; i++) {
            if (/jacuzzi|whirlpool/i.test(labels[i].textContent)) return labels[i].closest('.field');
          }
          return null;
        }
        // Komunikat dla każdej wybranej opcji poza rezygnacją („Nie będę korzystać”, „I will not use”, „… nicht nutzen”).
        function jacuzziWanted(field) {
          var el = field.querySelector('.multiselect__single') || field.querySelector('.multiselect__option--selected');
          var txt = el ? el.textContent.trim() : '';
          if (!txt) return false;
          return !/nie będę|nie bede|will not|won't|nicht/i.test(txt);
        }

        function place(id, anchor, html, isHtml) {
          var box = document.getElementById(id);
          if (!html || !anchor) { if (box) box.remove(); return; }
          if (!box) {
            box = document.createElement('div');
            box.id = id;
            box.setAttribute('role', id === 'lb-minstay-msg' ? 'alert' : 'status');
            box.style.cssText = id === 'lb-jacuzzi-msg' ? INFO_STYLE : BOX_STYLE;
          }
          if (isHtml) { if (box.innerHTML !== html) box.innerHTML = html; } else if (box.textContent !== html) { box.textContent = html; }
          if (box.previousElementSibling !== anchor) anchor.insertAdjacentElement('afterend', box);
        }

        function check() {
          readArrival();
          var nights = readNights();
          var dep = arrival !== null && nights > 0 ? arrival + nights * DAY : null;

          // 1) minimalny pobyt
          violated = null;
          if (dep !== null) {
            rules.forEach(function (r) {
              if (overlaps(dep, r) && nights < r.min && (!violated || r.min > violated.min)) violated = r;
            });
          }
          place('lb-minstay-msg',
            document.querySelector('#bookero-plugin .calendar-wrapper') || document.querySelector('#bookero-plugin .submit-section'),
            violated ? minStayText(violated) : '', false);

          // 2) jacuzzi zimą
          var field = jacuzziField();
          var showJacuzzi = false;
          if (field && dep !== null && jacuzziWanted(field)) {
            showJacuzzi = jacuzziPeriods.some(function (p) { return overlaps(dep, p); });
          }
          place('lb-jacuzzi-msg', field, showJacuzzi ? jacuzziHtml() : '', true);
          syncNote(showJacuzzi);
        }

        // Blokada przycisku „Przejdź do podsumowania” / „Wyślij”, dopóki pobyt jest za krótki.
        document.addEventListener('click', function (e) {
          var btn = e.target.closest && e.target.closest('#bookero-plugin .submit-section .submit-button');
          if (!btn) return;
          check();
          if (violated) {
            e.preventDefault();
            e.stopImmediatePropagation();
            var box = document.getElementById('lb-minstay-msg');
            if (box) box.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }, true);

        // Sprawdzanie po każdej zmianie w formularzu (wybór dnia, liczba dób, miesiąc, opcja jacuzzi).
        var queued = false;
        function schedule() { if (queued) return; queued = true; requestAnimationFrame(function () { queued = false; check(); }); }
        new MutationObserver(function (list) {
          for (var i = 0; i < list.length; i++) {
            var t = list[i].target;
            if (t.closest && (t.closest('#lb-minstay-msg') || t.closest('#lb-jacuzzi-msg'))) continue;
            if (t.closest && t.closest('#bookero-plugin')) { schedule(); return; }
            // Formularz Bookero dodany do strony w całości (np. przy pierwszym otwarciu)
            if (list[i].type === 'childList' && t.querySelector && t.querySelector('#bookero-plugin')) { schedule(); return; }
          }
        }).observe(document.documentElement, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ['class', 'value'] });
        document.addEventListener('input', schedule, true);
        document.addEventListener('change', schedule, true);
        document.addEventListener('focusout', schedule, true);
      })();
    </script>

    <!-- Bookero Validation (Minimum 2 nights) -->
    <script is:inline>
      (function() {
        var MIN_DAYS = 2;

        function enforceMin(e) {
          var days = 10;
          if (e && e.detail != undefined) {
            days = e.detail.data.number;
          } else if (document.getElementById('bookero-plugin-days-number')) {
            days = parseInt(document.getElementById('bookero-plugin-days-number').value) || 1;
          }

          if (days < MIN_DAYS && document.getElementById('bookero-plugin-days-number')) {
            setTimeout(function() {
              document.getElementById('bookero-plugin-days-number').value = MIN_DAYS;
              setTimeout(function() {
                var inputEvent = new Event('input');
                document.getElementById('bookero-plugin-days-number').dispatchEvent(inputEvent);
                var changeEvent = new Event('change');
                document.getElementById('bookero-plugin-days-number').dispatchEvent(changeEvent);
              }, 100);
            }, 100);
          }
        }

        function initValidation() {
          document.body.addEventListener('bookero-plugin:days-changed', enforceMin);
          document.body.addEventListener('bookero-plugin:service-updated', function() {
            setTimeout(function() {
              document.body.dispatchEvent(new Event('bookero-plugin:days-changed'));
            }, 100);
          });
          document.body.addEventListener('bookero-plugin:loaded', function() {
            setTimeout(function() {
              document.body.dispatchEvent(new Event('bookero-plugin:days-changed'));
            }, 100);
          });
        }

        window.enforceBookeroMinDays = function() {
          document.body.dispatchEvent(new Event('bookero-plugin:days-changed'));
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initValidation);
        } else {
          initValidation();
        }
      })();
    </script>

    <!-- Język strony zapamiętany w karcie przeglądarki: strona podziękowania po PayPal pokaże właściwą wersję.
         Na stronach noindex (np. podziękowanie) nie nadpisujemy zapamiętanego języka. -->
    {!noindex && (
      <script is:inline define:vars={{ lang }}>
        try { sessionStorage.setItem('lb_lang', lang); } catch (e) {}
      </script>
    )}

    <slot name="head" />
  </head>
  <body class="font-sans font-light">
    <div id="bookero"></div>

    <!-- Sticky reservation button - hidden until first scroll, then visible until Bookero loads its own -->
    <button
      id="bookero-sticky-fallback"
      onclick="openReservation()"
      style="display:none"
      class="fixed bottom-0 right-0 z-[99998] bg-[#2F6940] text-white font-bold border-0 cursor-pointer font-montserrat transition-colors hover:bg-[#40a95c]"
    >
      {lang === 'pl' ? 'Rezerwacja' : lang === 'en' ? 'Book Now' : 'Reservieren'}
    </button>
    <style>
      #bookero-sticky-fallback {
        width: 220px;
        height: 56px;
        opacity: 0.96;
        right: 3px;
        bottom: 3px;
        font-size: large;
        border-radius: 6px;
      }
      @media (max-width: 960px) {
        #bookero-sticky-fallback {
          width: 100vw !important;
          max-width: 100vw !important;
          height: 60px !important;
          margin-bottom: 0 !important;
          bottom: 0 !important;
          left: 0 !important;
          right: 0 !important;
          border-radius: 0 !important;
        }
      }
    </style>

    <!-- Show sticky fallback only after first scroll / touch (desktop + mobile) -->
    <script is:inline>
      (function() {
        function showFallback() {
          var btn = document.getElementById('bookero-sticky-fallback');
          // don't show if Bookero already rendered its own toggle
          if (btn && !document.querySelector('.bookero-sticky-plugin-toggle')) {
            btn.style.display = '';
          }
        }
        window.addEventListener('scroll', showFallback, { once: true, passive: true });
        window.addEventListener('touchmove', showFallback, { once: true, passive: true });
      })();
    </script>

    <slot />
  </body>
</html>