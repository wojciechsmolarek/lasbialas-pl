---
import { Picture } from 'astro:assets';
import lasbialasJacuzzi1 from '../../assets/foto/lasbialas-jacuzzi1.webp';
import sauna1 from '../../assets/foto/sauna1.webp';
import lasbialasJacuzzi3 from '../../assets/foto/lasbialas-jacuzzi3.webp';
import w6 from '../../assets/foto/w6.webp';
import lasbialas4 from '../../assets/foto/lasbialas4.webp';
import lasbialas7 from '../../assets/foto/lasbialas7.webp';
import balia from '../../assets/foto/balia.jpg';
import grill from '../../assets/foto/grill.webp';
import jezioroBiale from '../../assets/foto/jezioro-biale.webp';
import plaza from '../../assets/foto/plaza.webp';
import ImageHints from '../ui/ImageHints.astro';
import { imageHint, insertHint } from '../ui/imageHint';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

const t = {
  pl: {
    title: 'Całoroczne domki na wynajem w Puszczy Noteckiej',
    p1: 'Zapraszamy do Las Biala\'s w Białej, wsi nad {lake}, w sercu Puszczy Noteckiej. Z dala od miejskiego zgiełku, na ogrodzonym leśnym terenie, około 400 m od {beach}, stoją dwa całoroczne domki przeznaczone dla dorosłych gości.',
    p2: 'Na miejscu jest {sauna} z {tub}, a za dopłatą również {jacuzzi} przy domku. Bez dodatkowych opłat dostępne są {grill}, {bikes}. Domki są ogrzewane przez cały rok, a temperaturę w każdym pomieszczeniu ustawia się osobnym {thermostat}.',
    lakeWord: 'Jeziorem Białym',
    lakeAlt: 'Jezioro Białe w Puszczy Noteckiej',
    beachWord: 'plaży',
    beachAlt: 'Plaża nad Jeziorem Białym',
    thermostatWord: 'termostatem',
    thermostatAlt: 'Termostat ogrzewania w domku',
    tubWord: 'balią',
    tubAlt: 'Balia z zimną wodą do schładzania przy saunie',
    saunaWord: 'sauna fińska',
    saunaAlt: 'Wnętrze sauny fińskiej',
    jacuzziWord: 'prywatne jacuzzi',
    jacuzziAlt: 'Prywatne jacuzzi na terenie domku',
    grillWord: 'grill',
    grillAlt: 'Murowany grill przy domku',
    bikesWord: 'rowery i deski SUP',
    bikesAlt: 'Rowery trekkingowe i deski SUP dla gości',
    banner1: 'Prywatnie i kameralnie',
    banner2: 'w środku lasu',
    bannerSub: 'SAUNA · JACUZZI · TYLKO 18+',
    altJacuzzi1: 'Prywatne jacuzzi przy domku, wśród sosen',
    altSauna: 'Sauna fińska z balią w lesie',
    altJacuzzi2: 'Prywatne jacuzzi na terenie domku',

    adultTitle: 'Domki tylko dla dorosłych (18+)',
    adultText: 'Las Biala\'s to miejsce do spokojnego odpoczynku we dwoje lub w małym gronie. Dlatego przyjmujemy wyłącznie osoby dorosłe, bez zwierząt. Na ogrodzonym terenie stoją tylko dwa domki, oddzielone drzewami, z wejściami oddalonymi od siebie o około 50 m. Formuła 18+ to świadomy wybór: cisza, prywatność i czas tylko dla siebie.',
    petTitle: 'Zasady dotyczące zwierząt',
    petText: 'Z uwagi na charakter obiektu oraz względy organizacyjne <b>nie przyjmujemy pobytów ze zwierzętami</b>.',
  },
  en: {
    title: 'Year-Round Cottages for Rent in the Noteć Forest',
    p1: 'Welcome to Las Biala\'s in Biała, a village on {lake} in the heart of the Noteć Forest. Away from the bustle of the city, on a fenced forest property about 400 m from the {beach}, stand two year-round cottages for adult guests.',
    p2: 'On site there is a {sauna} with a {tub}, and a {jacuzzi} next to the cottage is available for an extra fee. The {grill} is free to use, as are the {bikes}. The cottages are heated all year round, and each room has its own {thermostat}.',
    lakeWord: 'Lake Białe',
    lakeAlt: 'Lake Białe in the Noteć Forest',
    beachWord: 'beach',
    beachAlt: 'Beach on Lake Białe',
    thermostatWord: 'thermostat',
    thermostatAlt: 'Heating thermostat in the cottage',
    tubWord: 'cold plunge tub',
    tubAlt: 'Cold plunge tub next to the sauna',
    saunaWord: 'Finnish sauna',
    saunaAlt: 'Inside the Finnish sauna',
    jacuzziWord: 'private jacuzzi',
    jacuzziAlt: 'Private jacuzzi on the cottage grounds',
    grillWord: 'barbecue grill',
    grillAlt: 'Brick barbecue grill by the cottage',
    bikesWord: 'bikes and SUP boards',
    bikesAlt: 'Trekking bikes and SUP boards for guests',
    banner1: 'Private and secluded',
    banner2: 'deep in the forest',
    bannerSub: 'SAUNA · JACUZZI · ADULTS ONLY',
    altJacuzzi1: 'Private jacuzzi by the cottage, among pine trees',
    altSauna: 'Finnish sauna with a cold plunge tub in the forest',
    altJacuzzi2: 'Private jacuzzi on the cottage grounds',

    adultTitle: 'Adults-Only Cottages (18+)',
    adultText: 'Las Biala\'s is a place for quiet time as a couple or in a small group. That is why we welcome adults only, with no pets. The fenced grounds hold just two cottages, separated by trees, with entrances about 50 m apart. The 18+ concept is a deliberate choice: silence, privacy and time just for yourselves.',
    petTitle: 'Pet policy',
    petText: 'Due to the character of the property and for organisational reasons, <b>stays with pets are not accepted</b>.',
  },
  de: {
    title: 'Ganzjährige Ferienhäuser in der Puszcza Notecka',
    p1: 'Willkommen bei Las Biala\'s in Biała, einem Dorf am {lake} im Herzen der Puszcza Notecka. Abseits vom Trubel der Stadt stehen auf einem eingezäunten Waldgrundstück, etwa 400 m vom {beach} entfernt, zwei ganzjährig nutzbare Ferienhäuser für erwachsene Gäste.',
    p2: 'Vor Ort gibt es eine {sauna} mit {tub}, außerdem gegen Aufpreis einen {jacuzzi} direkt am Haus. Kostenlos zur Verfügung stehen ein {grill}, {bikes}. Die Häuser sind das ganze Jahr über beheizt, und jeder Raum hat einen eigenen {thermostat}.',
    lakeWord: 'See Białe',
    lakeAlt: 'See Białe in der Puszcza Notecka',
    beachWord: 'Strand',
    beachAlt: 'Strand am See Białe',
    thermostatWord: 'Thermostat',
    thermostatAlt: 'Heizungsthermostat im Ferienhaus',
    tubWord: 'Kaltwasserbottich',
    tubAlt: 'Kaltwasserbottich neben der Sauna',
    saunaWord: 'finnische Sauna',
    saunaAlt: 'Innenraum der finnischen Sauna',
    jacuzziWord: 'privaten Whirlpool',
    jacuzziAlt: 'Privater Whirlpool auf dem Grundstück',
    grillWord: 'Grill',
    grillAlt: 'Gemauerter Grill am Ferienhaus',
    bikesWord: 'Fahrräder und SUP-Boards',
    bikesAlt: 'Trekkingräder und SUP-Boards für Gäste',
    banner1: 'Privat und ruhig',
    banner2: 'mitten im Wald',
    bannerSub: 'SAUNA · WHIRLPOOL · NUR 18+',
    altJacuzzi1: 'Privater Whirlpool am Ferienhaus, zwischen Kiefern',
    altSauna: 'Finnische Sauna mit Kaltwasserbottich im Wald',
    altJacuzzi2: 'Privater Whirlpool auf dem Grundstück',

    adultTitle: 'Nur für Erwachsene (18+)',
    adultText: 'Las Biala\'s ist ein Ort für erholsame Tage zu zweit oder in kleiner Runde. Deshalb begrüßen wir ausschließlich Erwachsene, ohne Haustiere. Auf dem eingezäunten Gelände stehen nur zwei Ferienhäuser, durch Bäume voneinander getrennt, mit Eingängen in etwa 50 m Abstand. Das 18+-Konzept ist eine bewusste Entscheidung: Stille, Privatsphäre und Zeit nur für sich.',
    petTitle: 'Haustierregelung',
    petText: 'Aufgrund der Beschaffenheit des Objekts und aus organisatorischen Gründen sind <b>Aufenthalte mit Haustieren nicht möglich</b>.',
  },
}[lang];

// Słowa z małym zdjęciem po najechaniu lub dotknięciu.
const thermostatHint = await imageHint({ word: t.thermostatWord, image: w6, alt: t.thermostatAlt });
const tubHint = await imageHint({ word: t.tubWord, image: balia, alt: t.tubAlt });
const saunaHint = await imageHint({ word: t.saunaWord, image: lasbialas7, alt: t.saunaAlt });
const jacuzziHint = await imageHint({ word: t.jacuzziWord, image: lasbialasJacuzzi3, alt: t.jacuzziAlt });
const grillHint = await imageHint({ word: t.grillWord, image: grill, alt: t.grillAlt });
const bikesHint = await imageHint({ word: t.bikesWord, image: lasbialas4, alt: t.bikesAlt });
let p2 = insertHint(t.p2, '{thermostat}', thermostatHint);
p2 = insertHint(p2, '{tub}', tubHint);
p2 = insertHint(p2, '{bikes}', bikesHint);
p2 = insertHint(p2, '{sauna}', saunaHint);
p2 = insertHint(p2, '{jacuzzi}', jacuzziHint);
p2 = insertHint(p2, '{grill}', grillHint);
const lakeHint = await imageHint({ word: t.lakeWord, image: jezioroBiale, alt: t.lakeAlt });
const beachHint = await imageHint({ word: t.beachWord, image: plaza, alt: t.beachAlt });
const introP1 = insertHint(insertHint(t.p1, '{lake}', lakeHint), '{beach}', beachHint);
---

<div id="domki" class="max-w-[73%] border border-[#ccc] rounded-[5px] py-[10px] px-[80px] mx-auto mb-5 bg-white text-base text-center max-[768px]:max-w-[96vw] max-[768px]:p-5 max-[768px]:my-[1px] max-[768px]:mb-5 max-[768px]:text-[0.6rem]">
  <h2 class="text-[24px] text-center mt-5 mb-5 text-brand-black font-bold">{t.title}</h2>
  <p class="text-base leading-[1.6]" set:html={introP1}></p>
  <p class="text-base leading-[1.6]" set:html={p2}></p>

  {/* Banner: hasło klimatu (nie nagłówek, żeby nie dublować sekcji „Sauna i jacuzzi”) */}
  <div class="relative w-full h-[300px] max-[768px]:h-[200px] mt-[50px] mb-[50px] rounded-[6px] overflow-hidden">
    <div class="absolute top-0 left-0 h-full w-[38%]">
      <Picture src={lasbialasJacuzzi1} alt={t.altJacuzzi1 ?? ''} width={600} height={400} widths={[300, 450, 600]} sizes="(max-width: 768px) 40vw, 300px" formats={['avif', 'webp']} loading="lazy" decoding="async" class="w-full h-full object-cover" />
    </div>
    <div class="absolute top-0 left-[22%] h-full w-[56%]" style="-webkit-mask-image:linear-gradient(to right,transparent,#000 20%,#000 80%,transparent);mask-image:linear-gradient(to right,transparent,#000 20%,#000 80%,transparent)">
      <Picture src={sauna1} alt={t.altSauna ?? ''} width={700} height={400} widths={[350, 525, 700]} sizes="(max-width: 768px) 55vw, 380px" formats={['avif', 'webp']} loading="lazy" decoding="async" class="w-full h-full object-cover" />
    </div>
    <div class="absolute top-0 right-0 h-full w-[34%]" style="-webkit-mask-image:linear-gradient(to right,transparent,#000 30%);mask-image:linear-gradient(to right,transparent,#000 30%)">
      <Picture src={lasbialasJacuzzi3} alt={t.altJacuzzi2 ?? ''} width={500} height={400} widths={[250, 375, 500]} sizes="(max-width: 768px) 36vw, 260px" formats={['avif', 'webp']} loading="lazy" decoding="async" class="w-full h-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-black/45"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
      <p class="text-white font-bold leading-[1.15] text-[2.4rem] max-[768px]:text-[1.4rem] drop-shadow-[0_2px_6px_rgba(0,0,0,0.6)]">
        {t.banner1}<br />{t.banner2}
      </p>
      <p class="text-white/90 mt-4 max-[768px]:mt-2 text-[0.95rem] max-[768px]:text-[0.7rem] tracking-[0.2em] drop-shadow-[0_1px_4px_rgba(0,0,0,0.7)]">
        {t.bannerSub}
      </p>
    </div>
  </div>

    {t.guideBtn && (
    <div class="flex justify-center mt-[30px]">
      <a class="inline-flex justify-center items-center w-auto h-[46px] text-base font-normal text-white bg-[#B5550E] border-none text-center no-underline normal-case cursor-pointer mb-[30px] mt-[10px] px-[15px] rounded-[6px] hover:bg-[#c4621a] transition-colors" href="#cennik">{t.guideBtn}</a>
    </div>
  )}

  <div class="mt-5">
    <h2 class="text-[24px] text-center mt-5 mb-5 text-brand-black font-bold">{t.adultTitle}</h2>
    <p class="text-base leading-[1.6]" set:html={t.adultText}></p>
  </div>

  {/* Pet policy */}
  <div class="mt-5 mb-5">
    <h3 class="text-[1.2rem] text-center mt-[40px] mb-[15px] font-semibold text-[#2c2c2c]">{t.petTitle}</h3>
    <p class="text-base leading-[1.6]" set:html={t.petText}></p>
  </div>
</div>

<ImageHints />
