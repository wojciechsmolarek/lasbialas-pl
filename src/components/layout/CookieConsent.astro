---
interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

// Tłumaczenia dla cookies - styl talem.eu
const translations = {
  pl: {
    title: 'Używamy plików cookie',
    description: 'Ta strona wykorzystuje pliki cookie w celu zapewnienia najlepszego doświadczenia użytkownika oraz analizy ruchu.',
    acceptAll: 'Zaakceptuj wszystkie',
    necessaryOnly: 'Tylko niezbędne',
    managePreferences: 'Zarządzaj preferencjami',
    privacy: 'Polityka prywatności',
    preferencesTitle: 'Zarządzaj preferencjami plików cookie',
    necessary: 'Niezbędne',
    analytics: 'Analityczne',
    marketing: 'Marketingowe',
    necessaryDesc: 'Wymagane do działania strony',
    analyticsDesc: 'Pomagają nam zrozumieć, jak korzystasz ze strony',
    marketingDesc: 'Używane do wyświetlania spersonalizowanych reklam',
    savePreferences: 'Zapisz preferencje'
  },
  en: {
    title: 'We use cookies',
    description: 'This website uses cookies to ensure the best user experience and traffic analysis.',
    acceptAll: 'Accept all',
    necessaryOnly: 'Only necessary',
    managePreferences: 'Manage preferences',
    privacy: 'Privacy Policy',
    preferencesTitle: 'Manage cookie preferences',
    necessary: 'Necessary',
    analytics: 'Analytics',
    marketing: 'Marketing',
    necessaryDesc: 'Required for the website to function',
    analyticsDesc: 'Help us understand how you use the site',
    marketingDesc: 'Used to display personalized ads',
    savePreferences: 'Save preferences'
  },
  de: {
    title: 'Wir verwenden Cookies',
    description: 'Diese Webseite verwendet Cookies, um die beste Benutzererfahrung und Traffic-Analyse zu gewährleisten.',
    acceptAll: 'Alle akzeptieren',
    necessaryOnly: 'Nur notwendige',
    managePreferences: 'Präferenzen verwalten',
    privacy: 'Datenschutzerklärung',
    preferencesTitle: 'Cookie-Präferenzen verwalten',
    necessary: 'Notwendig',
    analytics: 'Analytisch',
    marketing: 'Marketing',
    necessaryDesc: 'Erforderlich für die Funktionsweise der Website',
    analyticsDesc: 'Helfen uns zu verstehen, wie Sie die Seite nutzen',
    marketingDesc: 'Werden für personalisierte Anzeigen verwendet',
    savePreferences: 'Präferenzen speichern'
  }
};

const t = translations[lang];
---

<!-- Mały dymek cookies na dole po lewej -->
<div id="cookie-banner" class="fixed bottom-4 left-1/2 -translate-x-1/2 sm:left-4 sm:translate-x-0 bg-white text-gray-800 p-4 rounded-lg shadow-lg z-[100000] hidden transition-all duration-300 w-[calc(100%-2rem)] sm:w-auto max-w-sm">
  <div class="mb-3">
    <p class="text-xs text-gray-600 leading-relaxed">{t.description}</p>
  </div>
  
  <div class="flex flex-col gap-2">
    <button 
      id="cookie-accept-all"
      class="w-full px-3 py-2 text-xs bg-brand-green text-white rounded hover:bg-[#2F6940] transition-colors font-medium"
    >
      {t.acceptAll}
    </button>
    <button 
      id="cookie-necessary-only"
      class="w-full px-3 py-2 text-xs bg-gray-200 text-gray-800 rounded hover:bg-gray-300 transition-colors"
    >
      {t.necessaryOnly}
    </button>
    <button 
      id="cookie-manage-preferences"
      class="w-full px-3 py-2 text-xs text-brand-green hover:text-[#2F6940] transition-colors underline"
    >
      {t.managePreferences}
    </button>
  </div>
</div>

<!-- Modal preferences are injected via JS only when user clicks "Manage preferences" -->

<script is:inline defer define:vars={{ t, lang }}>
  // Cookie Consent + Google Analytics (Consent Mode v2).
  // GA ładuje się WYŁĄCZNIE po zgodzie na pliki analityczne (cc_cookies = analytics lub all).
  (function() {
    const cookieName = 'cc_cookies';
    const GA_ID = 'G-R3P2XT4WY8';
    const banner = document.getElementById('cookie-banner');
    const acceptAllBtn = document.getElementById('cookie-accept-all');
    const necessaryOnlyBtn = document.getElementById('cookie-necessary-only');
    const managePreferencesBtn = document.getElementById('cookie-manage-preferences');

    let modal = null;
    let modalInjected = false;

    // --- Google Analytics: domyślnie wszystko zablokowane ---
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function() { window.dataLayer.push(arguments); };
    window.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });

    let gaLoaded = false;
    function loadGA() {
      if (gaLoaded) return;
      gaLoaded = true;
      var s = document.createElement('script');
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      s.async = true;
      document.head.appendChild(s);
      window.gtag('js', new Date());
      window.gtag('config', GA_ID, { anonymize_ip: true });
    }

    // Ustawia zgody w Consent Mode i ładuje GA, jeśli jest zgoda na analityczne.
    function applyConsent(value) {
      var analytics = value === 'analytics' || value === 'all';
      var marketing = value === 'all';
      window.gtag('consent', 'update', {
        analytics_storage: analytics ? 'granted' : 'denied',
        ad_storage: marketing ? 'granted' : 'denied',
        ad_user_data: marketing ? 'granted' : 'denied',
        ad_personalization: marketing ? 'granted' : 'denied'
      });
      if (analytics) {
        loadGA();
      } else {
        removeGACookies();
      }
    }

    // Usuwa ciasteczka GA/Ads, jeśli gość wycofał lub nie dał zgody.
    function removeGACookies() {
      var host = location.hostname.replace(/^www\./, '');
      document.cookie.split(';').forEach(function(c) {
        var name = c.split('=')[0].trim();
        if (name === '_ga' || name.indexOf('_ga_') === 0 || name === '_gid' || name === '_gcl_au') {
          var past = '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
          document.cookie = name + past;
          document.cookie = name + past + ';domain=.' + host;
          document.cookie = name + past + ';domain=' + host;
        }
      });
    }

    function readConsent() {
      var m = document.cookie.match(new RegExp('(?:^|; )' + cookieName + '=([^;]*)'));
      return m ? m[1] : '';
    }

    // Powracający gość: zgoda już zapisana.
    var saved = readConsent();
    if (saved) {
      if (banner) banner.style.display = 'none';
      if (saved === 'analytics' || saved === 'all') {
        // GA dopiero przy pierwszej interakcji, żeby nie spowalniać ładowania strony.
        var start = function() { applyConsent(saved); };
        window.addEventListener('scroll', start, { once: true, passive: true });
        window.addEventListener('mousemove', start, { once: true });
        window.addEventListener('touchstart', start, { once: true, passive: true });
        window.addEventListener('keydown', start, { once: true });
      } else {
        removeGACookies();
      }
      return;
    }

    // Show banner after delay
    setTimeout(() => {
      if (banner) {
        banner.classList.remove('hidden');
      }
    }, 1000);

    // Set cookie function
    function setCookie(value, days = 365) {
      const date = new Date();
      date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
      const expires = 'expires=' + date.toUTCString();
      document.cookie = cookieName + '=' + value + ';' + expires + ';path=/;SameSite=Lax';
    }

    // Hide banner function
    function hideBanner() {
      if (banner) {
        banner.classList.add('hidden');
      }
    }

    // Inject modal HTML into DOM (lazy-load)
    function injectModal() {
      if (modalInjected) return;
      modalInjected = true;

      var privacyHref = lang === 'pl' ? '/polityka-prywatnosci' : lang === 'en' ? '/en/privacy-policy' : '/de/datenschutzerklarung';

      var html = '<div id="cookie-preferences-modal" class="fixed inset-0 bg-black bg-opacity-50 z-[100001] hidden flex items-center justify-center p-4">' +
        '<div class="bg-white rounded-lg max-w-md w-full max-h-[90vh] overflow-y-auto">' +
          '<div class="p-6">' +
            '<div class="flex justify-between items-center mb-4">' +
              '<h3 class="text-lg font-semibold">' + t.preferencesTitle + '</h3>' +
              '<button id="close-modal" class="text-gray-400 hover:text-gray-600 text-2xl leading-none">&times;</button>' +
            '</div>' +
            '<div class="space-y-4 mb-6">' +
              '<div class="flex items-center justify-between">' +
                '<div class="flex-1">' +
                  '<label class="font-medium text-sm">' + t.necessary + '</label>' +
                  '<p class="text-xs text-gray-600 mt-1">' + t.necessaryDesc + '</p>' +
                '</div>' +
                '<input type="checkbox" id="necessary-cookies" checked disabled class="w-4 h-4 text-brand-green rounded">' +
              '</div>' +
              '<div class="flex items-center justify-between">' +
                '<div class="flex-1">' +
                  '<label class="font-medium text-sm">' + t.analytics + '</label>' +
                  '<p class="text-xs text-gray-600 mt-1">' + t.analyticsDesc + '</p>' +
                '</div>' +
                '<input type="checkbox" id="analytics-cookies" class="w-4 h-4 text-brand-green rounded">' +
              '</div>' +
              '<div class="flex items-center justify-between">' +
                '<div class="flex-1">' +
                  '<label class="font-medium text-sm">' + t.marketing + '</label>' +
                  '<p class="text-xs text-gray-600 mt-1">' + t.marketingDesc + '</p>' +
                '</div>' +
                '<input type="checkbox" id="marketing-cookies" class="w-4 h-4 text-brand-green rounded">' +
              '</div>' +
            '</div>' +
            '<div class="flex gap-2">' +
              '<button id="save-preferences" class="flex-1 px-4 py-2 text-sm bg-brand-green text-white rounded hover:bg-[#2F6940] transition-colors">' + t.savePreferences + '</button>' +
              '<a href="' + privacyHref + '" class="flex-1 px-4 py-2 text-sm text-center text-gray-600 hover:text-gray-800 underline transition-colors">' + t.privacy + '</a>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>';

      document.body.insertAdjacentHTML('beforeend', html);
      modal = document.getElementById('cookie-preferences-modal');
      bindModalEvents();
    }

    // Show modal
    function showModal() {
      injectModal();
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    // Hide modal
    function hideModal() {
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    // Bind events to dynamically injected modal elements
    function bindModalEvents() {
      var closeModalBtn = document.getElementById('close-modal');
      var savePreferencesBtn = document.getElementById('save-preferences');

      if (closeModalBtn) {
        closeModalBtn.addEventListener('click', hideModal);
      }

      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) {
            hideModal();
          }
        });
      }

      if (savePreferencesBtn) {
        savePreferencesBtn.addEventListener('click', function() {
          var analyticsCheckbox = document.getElementById('analytics-cookies');
          var marketingCheckbox = document.getElementById('marketing-cookies');
          var analyticsEnabled = analyticsCheckbox && analyticsCheckbox.checked;
          var marketingEnabled = marketingCheckbox && marketingCheckbox.checked;

          var consentValue = 'necessary';
          if (analyticsEnabled && marketingEnabled) {
            consentValue = 'all';
          } else if (analyticsEnabled) {
            consentValue = 'analytics';
          }

          setCookie(consentValue);
          hideBanner();
          hideModal();
          applyConsent(consentValue);
        });
      }
    }

    // Accept all cookies
    if (acceptAllBtn) {
      acceptAllBtn.addEventListener('click', function() {
        setCookie('all');
        hideBanner();
        applyConsent('all');
      });
    }

    // Accept only necessary cookies
    if (necessaryOnlyBtn) {
      necessaryOnlyBtn.addEventListener('click', function() {
        setCookie('necessary');
        hideBanner();
        applyConsent('necessary');
      });
    }

    // Show preferences modal (lazy inject on click)
    if (managePreferencesBtn) {
      managePreferencesBtn.addEventListener('click', function() {
        showModal();
      });
    }
  })();
</script>
