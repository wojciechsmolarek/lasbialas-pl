---
import { faqData } from '../../data/faqData';
import lasbialas8 from '../../assets/foto/lasbialas8.webp';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

const pageUrl = {
  pl: 'https://lasbialas.pl/',
  en: 'https://lasbialas.pl/en',
  de: 'https://lasbialas.pl/de',
}[lang];

const texts = {
  pl: {
    name: "Las Biala's – domki z sauną i jacuzzi w Puszczy Noteckiej",
    description: 'Dwa całoroczne domki tylko dla dorosłych w Białej, w Puszczy Noteckiej, około 400 m od plaży nad Jeziorem Białym. Sauna fińska w cenie pobytu, prywatne jacuzzi za dopłatą, rowery, deski SUP i grill.',
    mainOffer: 'Pobyt w domku dla 1–2 osób, cena za dobę',
    mainOfferDesc: 'Cena za dobę przy pobycie od 4 dób. Obejmuje saunę, rowery, deski SUP i grill. Minimalny pobyt: 2 doby. 3. i 4. osoba: +120 zł za osobę za dobę.',
    jacuzziOffer: 'Wynajem prywatnego jacuzzi',
    jacuzziOfferDesc: 'Cena za pobyt 2–3 doby dla 1–2 osób, z opłatą za przygotowanie jacuzzi. Cena zależy od długości pobytu i liczby osób.',
    amenities: ['Sauna fińska', 'Prywatne jacuzzi (za dopłatą)', 'Bezpłatne Wi-Fi', 'Bezpłatny parking', 'Grill', 'Rowery', 'Deski SUP', 'Smart TV z Netflixem', 'Zmywarka', 'Ogrzewanie z termostatem'],
  },
  en: {
    name: "Las Biala's – cottages with sauna and jacuzzi in the Noteć Forest",
    description: 'Two year-round, adults-only cottages in Biała, in the Noteć Forest, about 400 m from the beach on Lake Białe. Finnish sauna included in the stay, private jacuzzi for an extra fee, bikes, SUP boards and a barbecue grill.',
    mainOffer: 'Cottage stay for 1–2 guests, price per night',
    mainOfferDesc: 'Price per night for stays of 4+ nights. Includes the sauna, bikes, SUP boards and barbecue grill. Minimum stay: 2 nights. 3rd and 4th guest: +120 PLN per person per night.',
    jacuzziOffer: 'Private jacuzzi rental',
    jacuzziOfferDesc: 'Price for a 2–3 night stay for 1–2 guests, including the jacuzzi preparation fee. The price depends on the length of stay and the number of guests.',
    amenities: ['Finnish sauna', 'Private jacuzzi (extra fee)', 'Free Wi-Fi', 'Free parking', 'Barbecue grill', 'Bikes', 'SUP boards', 'Smart TV with Netflix', 'Dishwasher', 'Heating with thermostat'],
  },
  de: {
    name: "Las Biala's – Ferienhäuser mit Sauna und Whirlpool in der Puszcza Notecka",
    description: 'Zwei ganzjährige Ferienhäuser nur für Erwachsene in Biała, in der Puszcza Notecka, etwa 400 m vom Strand am See Białe. Finnische Sauna im Preis inbegriffen, privater Whirlpool gegen Aufpreis, Fahrräder, SUP-Boards und Grill.',
    mainOffer: 'Aufenthalt im Ferienhaus für 1–2 Personen, Preis pro Nacht',
    mainOfferDesc: 'Preis pro Nacht bei Aufenthalten ab 4 Nächten. Inklusive Sauna, Fahrrädern, SUP-Boards und Grill. Mindestaufenthalt: 2 Nächte. 3. und 4. Person: +120 PLN pro Person und Nacht.',
    jacuzziOffer: 'Miete des privaten Whirlpools',
    jacuzziOfferDesc: 'Preis für einen Aufenthalt von 2–3 Nächten für 1–2 Personen, inklusive Vorbereitungsgebühr. Der Preis hängt von der Aufenthaltsdauer und der Personenzahl ab.',
    amenities: ['Finnische Sauna', 'Privater Whirlpool (gegen Aufpreis)', 'Kostenloses WLAN', 'Kostenloser Parkplatz', 'Grill', 'Fahrräder', 'SUP-Boards', 'Smart TV mit Netflix', 'Spülmaschine', 'Heizung mit Thermostat'],
  },
}[lang];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LodgingBusiness',
      '@id': 'https://lasbialas.pl/#lodging',
      name: texts.name,
      description: texts.description,
      url: pageUrl,
      image: `https://lasbialas.pl${lasbialas8.src}`,
      telephone: '+48789773285',
      email: 'domki@lasbialas.pl',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Biała 32/32',
        addressLocality: 'Biała',
        addressRegion: 'Wielkopolskie',
        postalCode: '64-730',
        addressCountry: 'PL',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 52.82654,
        longitude: 16.30411,
      },
      hasMap: 'https://www.google.com/maps?cid=2914860482544137358',
      sameAs: [
        'https://www.instagram.com/lasbialas',
        'https://www.booking.com/hotel/pl/las-bialas-kameralne-domki-w-puszczy-noteckiej.html',
        'https://www.airbnb.pl/h/lasbialas1',
        'https://www.airbnb.pl/h/lasbialas2',
        'https://alohacamp.com/pl/property/las-biala-3828',
        'https://www.google.com/maps?cid=2914860482544137358',
      ],
      priceRange: '475–525 PLN',
      currenciesAccepted: 'PLN',
      checkinTime: '16:00',
      checkoutTime: '12:00',
      petsAllowed: false,
      numberOfRooms: 2,
      amenityFeature: texts.amenities.map((name) => ({
        '@type': 'LocationFeatureSpecification',
        name,
        value: true,
      })),
      makesOffer: [
        {
          '@type': 'Offer',
          name: texts.mainOffer,
          description: texts.mainOfferDesc,
          priceSpecification: {
            '@type': 'UnitPriceSpecification',
            price: 475,
            priceCurrency: 'PLN',
            unitCode: 'DAY',
          },
          eligibleQuantity: {
            '@type': 'QuantitativeValue',
            minValue: 2,
            unitCode: 'DAY',
          },
          url: `${pageUrl}#cennik`,
        },
        {
          '@type': 'Offer',
          name: texts.jacuzziOffer,
          description: texts.jacuzziOfferDesc,
          price: 480,
          priceCurrency: 'PLN',
          url: `${pageUrl}#cennik-jacuzzi`,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqData[lang].flatMap((cat: any) =>
        cat.questions.map((item: any) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.a,
          },
        }))
      ),
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
