---
import { Picture } from 'astro:assets';
import car from '../../assets/images/car.png';
import train from '../../assets/images/train.png';
import dojazdLokalny from '../../assets/foto/dojazd-lokalny.png';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

const t = {
  pl: {
    carTitle: 'Dojazd samochodem',
    carBtn: 'Wyznacz trasę',
    carText: 'Link powyżej prowadzi w Google Maps do miejsca oddalonego o około 300 m od domków. Ten ostatni odcinek to droga leśna, a dalszy dojazd pokazuje <a href="https://lasbialas.pl/info/#/przed-przyjazdem/38" class="text-brand-green underline">mapka dojazdu na miejscu</a>. Współrzędne GPS domków: 52.82654, 16.30411.',
    trainTitle: 'Dojazd pociągiem',
    trainBtn: 'Stacja Miały na mapie',
    trainText: 'Po wcześniejszym uzgodnieniu zapewniamy bezpłatny transfer ze stacji kolejowej Miały, oddalonej o około 10 km, do domków Las Biala\'s oraz bezpłatny transfer powrotny w dniu wyjazdu. Szczegóły ustalamy indywidualnie przed przyjazdem.',
    locationTitle: 'Lokalizacja domków',
    locationText: '64-730 Biała, Puszcza Notecka, Wielkopolska · GPS: 52.82654, 16.30411',
    mapBtn: 'Mapka dojazdu na miejscu',
    mapHref: 'https://lasbialas.pl/info/#/przed-przyjazdem/38',
  },
  en: {
    carTitle: 'Arrival by car',
    carBtn: 'Plan route',
    carText: 'The link above takes you in Google Maps to a point about 300 metres from the cottages. This last stretch is a forest road, and the rest of the way is shown on the <a href="https://lasbialas.pl/info/en/#/before-arrival/1038" class="text-brand-green underline">local access map</a>. GPS coordinates of the cottages: 52.82654, 16.30411.',
    trainTitle: 'Arrival by train',
    trainBtn: 'Miały station on the map',
    trainText: 'By prior arrangement, we provide a free transfer from Miały railway station, about 10 km away, to the Las Biala\'s cottages, as well as a free return transfer on the day of departure. Details are agreed individually before arrival.',
    locationTitle: 'Location of Las Biala\'s cottages',
    locationText: '64-730 Biała, Noteć Forest, Greater Poland · GPS: 52.82654, 16.30411',
    mapBtn: 'Local access map',
    mapHref: 'https://lasbialas.pl/info/en/#/before-arrival/1038',
  },
  de: {
    carTitle: 'Anreise mit dem Auto',
    carBtn: 'Route planen',
    carText: 'Der Link oben führt in Google Maps zu einem Punkt etwa 300 Meter von den Ferienhäusern entfernt. Dieses letzte Stück ist ein Waldweg, den weiteren Weg zeigt die <a href="https://lasbialas.pl/info/de/#/vor-der-anreise/721" class="text-brand-green underline">Anfahrtskarte vor Ort</a>. GPS-Koordinaten der Ferienhäuser: 52.82654, 16.30411.',
    trainTitle: 'Anreise mit dem Zug',
    trainBtn: 'Bahnhof Miały auf der Karte',
    trainText: 'Nach vorheriger Absprache bieten wir einen kostenlosen Transfer vom etwa 10 km entfernten Bahnhof Miały zu den Ferienhäusern Las Biala\'s sowie einen kostenlosen Rücktransfer am Abreisetag an. Die Einzelheiten werden vor der Anreise individuell vereinbart.',
    locationTitle: 'Standort Las Biala\'s',
    locationText: '64-730 Biała, Puszcza Notecka, Großpolen · GPS: 52.82654, 16.30411',
    mapBtn: 'Anfahrtskarte vor Ort',
    mapHref: 'https://lasbialas.pl/info/de/#/vor-der-anreise/721',
  },
}[lang];

const carHref = 'https://www.google.com/maps/dir//52.8265399,16.3041079/@52.8200488,16.3011326,2526m/data=!3m1!1e3!4m2!4m1!3e0?hl=pl&entry=ttu';
const trainHref = 'https://www.google.pl/maps/place/Mia%C5%82y/@52.8296365,16.2440022,13.29z';
---

<div class="max-w-[73%] border border-[#ccc] rounded-[5px] py-[10px] px-[80px] mx-auto mb-5 bg-white text-base text-center max-[768px]:max-w-[96vw] max-[768px]:p-5 max-[768px]:my-[1px] max-[768px]:mb-5 max-[768px]:text-[0.6rem]">
  {/* Car */}
  <h2 class="text-[24px] max-[768px]:text-[1.2rem] mt-5 mb-5 text-brand-black font-bold">{t.carTitle}</h2>
  <div class="text-center mt-2.5 mb-5">
    <a href={carHref} rel="nofollow noopener noreferrer" class="inline-flex items-center text-[18px] text-brand-green no-underline" target="_blank">
      <Picture alt="" height={45} width={45} src={car} formats={['avif', 'webp']} class="mr-[5px] align-middle" />
      <span class="leading-none">{t.carBtn}</span>
    </a>
    <p class="text-base leading-[1.6]" set:html={t.carText}></p>
  </div>

  <br />

  {/* Train */}
  <h2 class="text-[24px] max-[768px]:text-[1.2rem] mt-5 mb-5 text-brand-black font-bold">{t.trainTitle}</h2>
  <div class="text-center mt-2.5 mb-5">
    <a href={trainHref} rel="nofollow noopener noreferrer" class="inline-flex items-center text-[18px] text-brand-green no-underline" target="_blank">
      <Picture alt="" height={45} width={45} src={train} formats={['avif', 'webp']} class="mr-[5px] align-middle" />
      <span class="leading-none">{t.trainBtn}</span>
    </a>
    <p class="text-base leading-[1.6]" set:html={t.trainText}></p>
  </div>

  <br />

  {/* Location */}
  <h2 class="text-[24px] max-[768px]:text-[1.2rem] mt-5 mb-5 text-brand-black font-bold">{t.locationTitle}</h2>
  <p class="text-base leading-[1.6]">{t.locationText}</p>
  <div class="text-center mt-2.5">
    <a href={t.mapHref} class="inline-flex items-center text-[18px] text-brand-green no-underline" target="_blank">
      <Picture alt="" height={42} width={42} src={dojazdLokalny} formats={['avif', 'webp']} class="mr-[5px] align-middle" />
      <span class="leading-none">{t.mapBtn}</span>
    </a>
  </div>

  {/* Map iframe */}
  <section class="w-full mt-[40px] rounded-[5px] text-center text-base bg-white">
    <iframe
      allowfullscreen=""
      height="450"
      loading="lazy"
      src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d9663.21760223439!2d16.3027!3d52.8263!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTLCsDQ5JzM0LjciNiAxNsKwMTgnMDkuNyJF!5e0!3m2!1spl!2spl!4v1682107501701!5m2!1spl!2spl"
      class="border-0 w-full"
      title={t.locationTitle}
      width="100%"
    ></iframe>
  </section>

</div>
