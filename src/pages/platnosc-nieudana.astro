---
import PageLayout from '../layouts/PageLayout.astro';
import PaymentFailedSection from '../components/sections/PaymentFailedSection.astro';

const lang = 'pl';
---

<!-- Strona po nieudanej lub anulowanej płatności PayPal: wyłączona z indeksowania (noindex) -->
<PageLayout
  title="Płatność nie została zakończona | Las Biala's"
  description="Płatność PayPal nie została zakończona. Możesz spróbować ponownie lub zapłacić BLIK-iem albo przelewem."
  lang={lang}
  noindex={true}
>
  <PaymentFailedSection lang={lang} />
</PageLayout>
