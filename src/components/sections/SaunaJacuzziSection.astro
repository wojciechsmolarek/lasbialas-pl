---
import { useTranslations } from '../../i18n/utils';
import { Picture } from 'astro:assets';
import saunaDlaGosci from '../../assets/foto/sauna-dla-gosci.png';
import jacuzzi from '../../assets/foto/jacuzzi.png';
import pergolaJacuzzi from '../../assets/foto/pergola_jacuzzi-1.webp';
import lasbialas6 from '../../assets/foto/lasbialas6.webp';
import lasbialas7 from '../../assets/foto/lasbialas7.webp';
import balia from '../../assets/foto/balia.jpg';
import ImageHints from '../ui/ImageHints.astro';
import { imageHint, insertHint } from '../ui/imageHint';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const icons = {
  sauna: saunaDlaGosci,
  jacuzzi: jacuzzi,
};

const sectionTitle = {
  pl: 'Sauna i jacuzzi w Puszczy Noteckiej',
  en: 'Sauna and Jacuzzi in the Noteć Forest',
  de: 'Sauna und Whirlpool in der Puszcza Notecka',
}[lang];

const guideHref = {
  pl: 'https://lasbialas.pl/info/#/na-miejscu/32',
  en: 'https://lasbialas.pl/info/en/#/on-site/32',
  de: 'https://lasbialas.pl/info/de/#/vor-ort/32',
}[lang];

const jacuzziHref = {
  pl: 'https://lasbialas.pl/info/#/na-miejscu/385',
  en: 'https://lasbialas.pl/info/en/#/on-site/385',
  de: 'https://lasbialas.pl/info/de/#/vor-ort/385',
}[lang];

// Słowo „pergolą” w opisie jacuzzi pokazuje zdjęcie pergoli po najechaniu lub dotknięciu.
// Tekst opisu jest w ui.ts. Jeśli zdanie z pergolą zostanie tam zmienione, opis wyświetli się normalnie, bez zdjęcia.
const pergola = {
  pl: { word: 'pergolą', alt: 'Jacuzzi pod pergolą z regulowanym zadaszeniem i zasłonami' },
  en: { word: 'pergola', alt: 'Jacuzzi under a pergola with an adjustable roof and curtains' },
  de: { word: 'Pergola', alt: 'Whirlpool unter einer Pergola mit verstellbarem Dach und Vorhängen' },
}[lang];
const pergolaHint = await imageHint({ word: pergola.word, image: pergolaJacuzzi, alt: pergola.alt, onDark: true });
const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const jacuzziDesc = insertHint(escapeHtml(t('section.jacuzzi_desc')), pergola.word, pergolaHint);

// Słowa w opisie sauny ze zdjęciami. Tekst opisu jest w ui.ts.
// Jeśli któreś słowo zostanie tam zmienione, wyświetli się normalnie, bez zdjęcia.
const saunaHints = {
  pl: [
    { word: 'Sauna fińska', image: lasbialas7, alt: 'Wnętrze sauny fińskiej' },
    { word: 'strefę wypoczynku', image: lasbialas6, alt: 'Sauna z tarasem i strefą wypoczynku wśród sosen' },
    { word: 'balią', image: balia, alt: 'Drewniana balia z zimną wodą do schładzania' },
  ],
  en: [
    { word: 'Finnish sauna', image: lasbialas7, alt: 'Inside the Finnish sauna' },
    { word: 'seating area', image: lasbialas6, alt: 'Sauna with a terrace among the pine trees' },
    { word: 'tub of cold water', image: balia, alt: 'Wooden cold plunge tub' },
  ],
  de: [
    { word: 'finnische Sauna', image: lasbialas7, alt: 'Innenraum der finnischen Sauna' },
    { word: 'Sitzbereich', image: lasbialas6, alt: 'Sauna mit Terrasse zwischen Kiefern' },
    { word: 'Kaltwasserbottich', image: balia, alt: 'Hölzerner Kaltwasserbottich' },
  ],
}[lang];
// Najpierw słowa zamieniamy na znaczniki, potem znaczniki na dymki,
// żeby opisy zdjęć (alt) jednego dymku nie były brane za słowo kolejnego.
let saunaDesc = escapeHtml(t('section.sauna_desc'));
saunaHints.forEach((h, i) => { saunaDesc = saunaDesc.replace(h.word, `{saunaHint${i}}`); });
for (const [i, h] of saunaHints.entries()) {
  const html = await imageHint({ word: h.word, image: h.image, alt: h.alt, onDark: true });
  saunaDesc = insertHint(saunaDesc, `{saunaHint${i}}`, html);
}

// Wpis na blogu jest tylko po polsku, więc link pokazujemy wyłącznie w wersji PL.
const saunaBlogLink = lang === 'pl'
  ? { href: '/blog/jak-bezpiecznie-schlodzic-sie-po-saunie-poradnik-krok-po-kroku/', label: 'Jak bezpiecznie schłodzić się po saunie? Poradnik na blogu' }
  : null;
---

<section id="sauna-jacuzzi" class="mx-auto my-[30px] max-w-[73%] max-[768px]:max-w-[96%]">
  <h2 class="text-[24px] max-[768px]:text-[1.2rem] text-center mt-5 mb-5 text-brand-black font-bold">{sectionTitle}</h2>

  <div class="flex justify-center gap-[10px] flex-wrap max-[768px]:gap-[20px]">
    <div class="flex flex-col flex-[1_1_48%] border border-[#ccc] rounded-[5px] p-5 text-white text-base text-center leading-[1.6] box-border bg-gradient-to-b from-[#6b6767c6] to-[#3c3939c6] max-[768px]:flex-[1_1_100%] max-[768px]:max-w-[96vw] max-[768px]:mb-5">
      <div class="text-center mb-[5px]">
        <Picture alt="" height={60} width={60} src={icons.sauna} formats={['avif', 'webp']} class="inline-block" />
      </div>
      <h3 class="text-center mt-[5px] mb-5 text-white text-[24px] font-bold">{t('section.sauna_title')}</h3>
      <p class="text-base leading-[1.6]" set:html={saunaDesc}></p>
      {saunaBlogLink && (
        <p class="text-base leading-[1.6] mt-4">
          <a href={saunaBlogLink.href} class="text-white underline hover:text-[#f3d9c4] transition-colors">{saunaBlogLink.label}</a>
        </p>
      )}
      <div class="flex justify-center mt-auto pt-[30px]">
        <a class="inline-flex justify-center items-center w-auto h-[46px] text-base font-normal text-white bg-[#B5550E] border-none text-center no-underline normal-case cursor-pointer mb-[30px] mt-[10px] px-[15px] rounded-[6px] hover:bg-[#c4621a] transition-colors" href={guideHref} target="_blank" rel="noopener" aria-label={t('button.sauna_rules')}>{t('button.rules')}</a>
      </div>
    </div>

    <div class="flex flex-col flex-[1_1_48%] border border-[#ccc] rounded-[5px] p-5 text-white text-base text-center leading-[1.6] box-border bg-gradient-to-b from-[#3c9b55cc] to-[#2F6940] max-[768px]:flex-[1_1_100%] max-[768px]:max-w-[96vw] max-[768px]:mb-5">
      <div class="text-center mb-[5px]">
        <Picture alt="" height={60} width={60} src={icons.jacuzzi} formats={['avif', 'webp']} class="inline-block" />
      </div>
      <h3 class="text-center mt-[5px] mb-5 text-white text-[24px] font-bold">{t('section.jacuzzi_title')}</h3>
      <p class="text-base leading-[1.6]" set:html={jacuzziDesc}></p>
      <div class="flex justify-center mt-auto pt-[30px]">
        <a class="inline-flex justify-center items-center w-auto h-[46px] text-base font-normal text-white bg-[#B5550E] border-none text-center no-underline normal-case cursor-pointer mb-[30px] mt-[10px] px-[15px] rounded-[6px] hover:bg-[#c4621a] transition-colors" href={jacuzziHref} target="_blank" rel="noopener" aria-label={t('button.jacuzzi_rules')}>{t('button.rules')}</a>
      </div>
    </div>
  </div>
</section>

<ImageHints />
