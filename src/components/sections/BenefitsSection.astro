---
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Benefit keys per language
const benefitKeysByLang = {
  pl: [
    'benefits.best_prices',
    'benefits.from_2_nights',
    'benefits.discounts',
    'benefits.flexible_checkin',
    'benefits.change_dates',
  ],
  en: [
    'benefits.best_prices',
    'benefits.from_2_nights',
    'benefits.flexible_checkin',
    'benefits.next_stay_discount',
    'benefits.change_dates',
    'benefits.discounts',
  ],
  de: [
    'benefits.best_prices',
    'benefits.from_2_nights',
    'benefits.flexible_checkin',
    'benefits.next_stay_discount',
    'benefits.change_dates',
    'benefits.discounts',
  ],
};

const benefitKeys = benefitKeysByLang[lang];
---

<!-- Jasne tło z ciemnym tekstem. Bez własnego przycisku: przycisk Rezerwuj jest tuż wyżej, w cenniku. -->
<div class="flex justify-center gap-[10px] flex-wrap my-[30px] mx-auto max-w-[73%] max-[768px]:gap-[20px] max-[768px]:max-w-[96%]">
  <div class="flex-[1_1_48%] border border-[#B9D4BF] rounded-[5px] p-5 text-brand-black text-base text-center leading-[1.6] box-border bg-[#E8F2EA] max-[768px]:flex-[1_1_100%] max-[768px]:max-w-[96vw] max-[768px]:mb-5">
    <h2 class="block text-center mt-[10px] mb-[10px] text-[1.2em] font-bold text-brand-black">
      {t('benefits.direct_booking_title')}
    </h2>
    <ul class="flex flex-wrap justify-center gap-y-[.4em] gap-x-[1.2em] mt-[.6em] mb-[10px] p-0 list-none">
      {benefitKeys.map((key: string) => (
        <li class="m-0 leading-[1.3] flex items-center text-[#272727]">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2F6940" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mr-[.5em]"><path d="M5 12l5 5L20 7"/></svg>
          {t(key)}
        </li>
      ))}
    </ul>
  </div>
</div>
