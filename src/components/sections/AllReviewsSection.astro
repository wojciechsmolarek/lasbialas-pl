---
import { reviews } from '../../data/reviewsData';
import PartnerLogos from './PartnerLogos.astro';
import ReviewCard from './ReviewCard.astro';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

const homeUrl = lang === 'pl' ? '/' : `/${lang}`;

const t = {
  pl: {
    title: 'Opinie naszych gości',
    intro: 'Poniżej zebraliśmy opinie gości z Google, Booking.com, Airbnb i AlohaCamp. Oryginały znajdziesz pod linkami do każdego serwisu.',
    back: '← Wróć na stronę główną',
    reserve: 'Rezerwuj',
  },
  en: {
    title: 'What our guests say',
    intro: 'Below are guest reviews from Google, Booking.com, Airbnb and AlohaCamp. You can read the originals via the links to each platform.',
    back: '← Back to the home page',
    reserve: 'Book Now',
  },
  de: {
    title: 'Bewertungen unserer Gäste',
    intro: 'Hier finden Sie Bewertungen unserer Gäste von Google, Booking.com, Airbnb und AlohaCamp. Die Originale erreichen Sie über die Links zu den jeweiligen Plattformen.',
    back: '← Zurück zur Startseite',
    reserve: 'Reservieren',
  },
}[lang];
---

<section class="max-w-[73%] border border-[#ccc] rounded-[5px] py-[10px] px-[80px] mx-auto my-5 bg-white text-base text-center max-[768px]:max-w-[96vw] max-[768px]:p-5 max-[768px]:my-[1px] max-[768px]:mb-5 max-[768px]:text-[1rem]">
  <h1 class="text-[28px] max-[768px]:text-[1.4rem] text-center mt-5 mb-4 text-brand-black font-bold">{t.title}</h1>
  <p class="text-base leading-[1.6] mb-5">{t.intro}</p>

  <PartnerLogos lang={lang} />

  <div class="grid grid-cols-2 gap-[20px] items-start mt-2 max-[768px]:grid-cols-1">
    {reviews.map((review) => <ReviewCard review={review} lang={lang} />)}
  </div>

  <div class="flex flex-wrap justify-center items-center gap-4 mt-[30px] mb-[30px]">
    <a href={homeUrl} class="text-brand-green underline">{t.back}</a>
    <a href="#" onclick="openReservation(); return false;" class="inline-flex justify-center items-center w-[140px] h-[46px] text-base text-white bg-[#2F6940] no-underline rounded-[6px] hover:bg-[#40a95c] transition-colors">{t.reserve}</a>
  </div>
</section>
