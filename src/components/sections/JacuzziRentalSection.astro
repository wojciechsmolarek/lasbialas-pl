---
interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

const t = {
  pl: {
    title: 'Wynajem jacuzzi',
    intro: 'Prywatne jacuzzi stoi na tarasie przy domku, pod pergolą z regulowanym zadaszeniem i zasłonami. Wynajem jest opcjonalny i obejmuje <b>nieograniczone korzystanie przez cały pobyt</b>. Woda jest podgrzewana przez całą dobę do 37–38 °C lub innej temperatury na życzenie. Przed każdym pobytem jacuzzi czyścimy i napełniamy świeżą wodą, a w trakcie pobytu regularnie je serwisujemy. Zamiast chloru stosujemy aktywny tlen, łagodniejszy dla skóry. Jacuzzi zamawia się, zaznaczając tę opcję w formularzu rezerwacji. W okresie dużych mrozów jacuzzi może być niedostępne, dlatego przy pobytach zimą jego dostępność potwierdzamy przed rezerwacją.',
    cols: ['Długość pobytu', 'Cena jacuzzi za pobyt (1–2 os.)'],
    rows: [
      ['2–3 doby', '480 zł'],
      ['4 doby', '580 zł'],
      ['5 dób', '670 zł'],
      ['każda kolejna doba (od 6.)', '+100 zł'],
    ],
    note: [
      'Ceny zawierają jednorazową opłatę <b>150 zł</b> za przygotowanie jacuzzi.',
      'Dla 3–4 osób: <b>+60 zł</b> przy pobycie 2–3 dób, <b>+20 zł</b> za każdą kolejną dobę.',
      'Cena zależy od liczby osób objętych rezerwacją.',
    ],
  },
  en: {
    title: 'Jacuzzi rental',
    intro: 'The private jacuzzi stands on the terrace next to the cottage, under a pergola with an adjustable roof and curtains. The rental is optional and includes <b>unlimited use throughout your stay</b>. The water is heated around the clock to 37–38 °C, or to another temperature on request. Before each stay we clean the jacuzzi and fill it with fresh water, and we service it regularly during your stay. Instead of chlorine we use active oxygen, which is gentler on the skin. The jacuzzi is ordered by selecting this option in the booking form. During severe frosts it may be unavailable, so for winter stays we confirm availability before booking.',
    cols: ['Length of stay', 'Jacuzzi price per stay (1–2 guests)'],
    rows: [
      ['2–3 nights', '480 PLN'],
      ['4 nights', '580 PLN'],
      ['5 nights', '670 PLN'],
      ['each additional night (from the 6th)', '+100 PLN'],
    ],
    note: [
      'Prices include a one-time <b>150 PLN</b> jacuzzi preparation fee.',
      'For 3–4 guests: <b>+60 PLN</b> for a 2–3 night stay, <b>+20 PLN</b> for each additional night.',
      'The price depends on the number of guests included in the booking.',
    ],
  },
  de: {
    title: 'Whirlpool-Miete',
    intro: 'Der private Whirlpool steht auf der Terrasse direkt am Ferienhaus, unter einer Pergola mit verstellbarem Dach und Vorhängen. Die Miete ist optional und umfasst die <b>unbegrenzte Nutzung während des gesamten Aufenthalts</b>. Das Wasser wird rund um die Uhr auf 37–38 °C oder auf Wunsch auf eine andere Temperatur beheizt. Vor jedem Aufenthalt reinigen wir den Whirlpool und füllen ihn mit frischem Wasser, während des Aufenthalts wird er regelmäßig gewartet. Statt Chlor verwenden wir Aktivsauerstoff, der schonender für die Haut ist. Der Whirlpool wird bestellt, indem diese Option im Buchungsformular ausgewählt wird. Bei starkem Frost kann er nicht verfügbar sein, daher bestätigen wir die Verfügbarkeit für Aufenthalte im Winter vor der Buchung.',
    cols: ['Aufenthaltsdauer', 'Whirlpool-Preis pro Aufenthalt (1–2 Pers.)'],
    rows: [
      ['2–3 Nächte', '480 PLN'],
      ['4 Nächte', '580 PLN'],
      ['5 Nächte', '670 PLN'],
      ['jede weitere Nacht (ab der 6.)', '+100 PLN'],
    ],
    note: [
      'Die Preise enthalten eine einmalige Gebühr von <b>150 PLN</b> für die Vorbereitung des Whirlpools.',
      'Für 3–4 Personen: <b>+60 PLN</b> bei 2–3 Nächten, <b>+20 PLN</b> für jede weitere Nacht.',
      'Der Preis richtet sich nach der Anzahl der Personen in der Buchung.',
    ],
  },
}[lang];

const tableClass = 'w-full max-w-[900px] border-collapse text-base max-[768px]:text-[1rem] my-[30px] mx-auto bg-[#f4f4f4] border-2 border-white text-center table-fixed';
const thClass = 'bg-[#362e27] text-white font-semibold px-[6px] py-[4px] h-[40px] border-2 border-white align-middle w-[50%] max-[768px]:text-[1rem] max-[768px]:leading-[1.2] max-[768px]:break-words max-[768px]:whitespace-normal';
const tdClass = 'h-[60px] p-[6px] border-2 border-white align-middle max-[768px]:text-[1rem] max-[768px]:h-[48px] max-[768px]:break-words';
---

<div class="max-w-[73%] border border-[#ccc] rounded-[5px] py-[10px] px-[80px] mx-auto mb-5 bg-white text-base text-center max-[768px]:max-w-[96vw] max-[768px]:p-5 max-[768px]:my-[1px] max-[768px]:mb-5 max-[768px]:text-[1rem]">
  <h2 class="text-[24px] max-[768px]:text-[1.2rem] mb-5 mt-5 text-brand-black font-bold" id="cennik-jacuzzi">{t.title}</h2>
  <p class="text-base max-[768px]:text-[1rem] leading-[1.6]" set:html={t.intro}></p>

  {/* Pricing table */}
  <table class={tableClass}>
    <thead>
      <tr>
        {t.cols.map((col: string) => (
          <th class={thClass} set:html={col}></th>
        ))}
      </tr>
    </thead>
    <tbody>
      {t.rows.map((row: string[]) => (
        <tr>
          {row.map((cell: string) => (
            <td class={tdClass} set:html={cell}></td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>

  {/* Notes */}
  <div class="max-w-[82%] max-[768px]:max-w-[98vw] border border-brand-green rounded-[5px] p-[5px] my-[5px] mx-auto mb-[30px] bg-white text-[1rem] max-[768px]:text-[1rem] text-brand-green text-center">
    {t.note.map((note: string) => (
      <p class="my-[5px]" set:html={note}></p>
    ))}
  </div>
</div>
