---
interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

const t = {
  pl: {
    title: 'Cennik 2026',
    cols: ['Cena za dobę 1-2 os.', 'Długość pobytu', '3-4 os.'],
    rows: [
      ['<strong>475 zł *</strong>', 'od 4 dób', '+120 zł / os.'],
      ['495 zł *', '3 doby', '+120 zł / os.'],
      ['525 zł', '2 doby', '+120 zł / os.'],
    ],
    stayHours: 'Doba pobytu trwa od 16:00 do 12:00 (poza sezonem letnim możliwość ustalenia innych godzin). Nie pobieramy opłat licznikowych. Wystawiamy fakturę VAT.',
    notes: [
      'Minimalny okres pobytu: <b>2 doby</b>.',
      '* rabat naliczany automatycznie w systemie rezerwacji.',
    ],
    amenitiesCols: ['Udogodnienia', 'Korzystanie'],
    amenitiesRows: [
      ['Sauna', 'bezpłatnie'],
      ['Rowery', 'bezpłatnie'],
      ['Deski SUP (V-X)', 'bezpłatnie'],
      ['Grill, węgiel, podpałka', 'bezpłatnie'],
      ['Jacuzzi (opcja)', 'wg <a href="#cennik-jacuzzi" class="text-brand-green underline">cennika</a>'],
    ],
    reserve: 'Rezerwuj',
    freeTitle: 'Bezpłatnie dla Gości',
    freeItems: ['sauna', 'balia z wodą do schładzania', 'szlafroki i ręczniki do saunowania', '4 rowery trekkingowe', 'grill', 'węgiel, podpałka do grilla', '4 deski SUP (od V do X)'],
    petTitle: 'Zasady dotyczące zwierząt',
    petText: 'Z uwagi na charakter obiektu oraz względy organizacyjne, <b>nie przyjmujemy pobytów ze zwierzętami.</b> Uprzejmie prosimy o uwzględnienie tej zasady przy planowaniu rezerwacji.',
  },
  en: {
    title: 'Pricing 2026',
    cols: ['Price per night 1-2 guests', 'Length of stay', '3-4 guests'],
    rows: [
      ['<strong>475 zł *</strong>', '4+ nights', '+120 zł / guest'],
      ['495 zł *', '3 nights', '+120 zł / guest'],
      ['525 zł', '2 nights', '+120 zł / guest'],
    ],
    stayHours: 'The stay lasts from 4:00 PM to 12:00 PM (other times can be arranged). No utility fees. VAT invoice available.',
    notes: [
      'Minimum stay: <b>2 nights</b>.',
      '* Discount is applied automatically in the booking system.',
    ],
    amenitiesCols: ['Amenities', 'Usage'],
    amenitiesRows: [
      ['Sauna', 'free'],
      ['Bicycles', 'free'],
      ['SUP boards (V-X)', 'free'],
      ['Grill, charcoal, fire starter', 'free'],
      ['Jacuzzi (optional)', 'per <a href="#cennik-jacuzzi" class="text-brand-green underline">price list</a>'],
    ],
    reserve: 'Book Now',
    freeTitle: 'Free for Guests',
    freeItems: ['sauna', 'cooling water tub', 'bathrobes and sauna towels', '4 trekking bikes', 'portable grill', 'charcoal, fire starter, and grill accessories', '4 SUP boards (from May to October)'],
    petTitle: 'Pet policy',
    petText: 'Due to the character of the property and organizational reasons, stays with pets are not accepted. Please take this into account when booking.',
  },
  de: {
    title: 'Preise 2026',
    cols: ['Preis pro Nacht 1-2 Pers.', 'Aufenthaltsdauer', '3-4 Pers.'],
    rows: [
      ['<strong>475 zł *</strong>', 'ab 4 Nächten', '+120 zł / Pers.'],
      ['495 zł *', '3 Nächte', '+120 zł / Pers.'],
      ['525 zł', '2 Nächte', '+120 zł / Pers.'],
    ],
    stayHours: 'Der Aufenthalt dauert von 16:00 bis 12:00 (andere Zeiten nach Absprache möglich). Es fallen keine Zählergebühren an. Wir stellen eine Rechnung mit MwSt. aus.',
    notes: [
      'Mindestaufenthalt: <b>2 Nächte</b>.',
      '* Der Rabatt wird automatisch im Buchungssystem angewendet.',
    ],
    amenitiesCols: ['Annehmlichkeiten', 'Nutzung'],
    amenitiesRows: [
      ['Sauna', 'kostenlos'],
      ['Fahrräder', 'kostenlos'],
      ['SUP-Boards (V-X)', 'kostenlos'],
      ['Grill, Holzkohle, Anzünder', 'kostenlos'],
      ['Jacuzzi (optional)', 'gemäß <a href="#cennik-jacuzzi" class="text-brand-green underline">Preisliste</a>'],
    ],
    reserve: 'Reservierung',
    freeTitle: 'Kostenlos für Gäste',
    freeItems: ['Sauna', 'Abkühlbottich mit Wasser', 'Bademäntel und Saunatücher', '4 Trekking-Fahrräder', 'tragbarer Grill', 'Kohle, Anzünder und Grillzubehör', '4 SUP-Boards (von Mai bis Oktober)'],
    petTitle: 'Haustierregelung',
    petText: 'Aufgrund der Beschaffenheit des Objekts und organisatorischer Gründe sind Aufenthalte mit Haustieren nicht gestattet. Bitte berücksichtigen Sie dies bei Ihrer Buchung.',
  },
}[lang];

const colW = ['w-[40%] max-[768px]:w-[38%]', 'w-[30%] max-[768px]:w-[30%]', 'w-[30%] max-[768px]:w-[32%]'];

const tableClass = 'w-full max-w-[900px] border-collapse text-base max-[768px]:text-[1rem] my-[30px] mx-auto bg-[#f4f4f4] border-2 border-white text-center table-fixed max-[768px]:table-auto';
const thClass = 'bg-[#362e27] text-white font-semibold px-[6px] py-[4px] h-[40px] border-2 border-white align-middle max-[768px]:text-[1rem] max-[768px]:leading-[1.2] max-[768px]:break-words max-[768px]:whitespace-normal';
const tdClass = 'h-[60px] p-[6px] border-2 border-white align-middle max-[768px]:text-[1rem] max-[768px]:h-[48px] max-[768px]:break-words';
---

<div id="cennik" class="scroll-mt-24 max-[768px]:scroll-mt-20 max-w-[73%] border border-[#ccc] rounded-[5px] py-[10px] px-[80px] mx-auto mb-5 bg-white text-base text-center max-[768px]:max-w-[96vw] max-[768px]:p-5 max-[768px]:my-[1px] max-[768px]:mb-5 max-[768px]:text-[0.75rem]">
  <h2 class="text-[24px] max-[768px]:text-[1.2rem] mt-5 mb-5 text-brand-black font-bold">{t.title}</h2>

  {/* Main pricing table */}
  <table class={tableClass}>
    <thead>
      <tr>
        {t.cols.map((col: string, i: number) => (
          <th class={`${thClass} ${colW[i] || ''}`} set:html={col}></th>
        ))}
      </tr>
    </thead>
    <tbody>
      {t.rows.map((row: string[]) => (
        <tr>
          {row.map((cell: string) => (
            <td class={tdClass} set:html={cell}></td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>

  {/* Stay hours */}
  <p class="text-base max-[768px]:text-[1rem] leading-[1.6] mb-6" set:html={t.stayHours}></p>

  {/* Notes */}
  <div class="max-w-[82%] max-[768px]:max-w-[98vw] border border-brand-green rounded-[5px] p-[5px] my-[5px] mx-auto bg-white text-[1rem] max-[768px]:text-[1rem] text-brand-green text-center">
    {t.notes.map((note: string) => (
      <p class="my-[5px]" set:html={note}></p>
    ))}
  </div>

  {/* Amenities table */}
  <table class={tableClass}>
    <thead>
      <tr>
        <th class={`${thClass} w-[60%]`} set:html={t.amenitiesCols[0]}></th>
        <th class={`${thClass} w-[40%]`} set:html={t.amenitiesCols[1]}></th>
      </tr>
    </thead>
    <tbody>
      {t.amenitiesRows.map((row: string[]) => (
        <tr>
          <td class={tdClass} set:html={row[0]}></td>
          <td class={tdClass} set:html={row[1]}></td>
        </tr>
      ))}
    </tbody>
  </table>

{/* Reserve button */}
  <div class="flex justify-center mt-[30px]">
    <a aria-label="Otwórz panel rezerwacji" class="flex justify-center items-center w-[140px] h-[46px] text-base font-normal text-white bg-[#2F6940] border-none text-center no-underline normal-case cursor-pointer font-montserrat mb-[30px] rounded-[6px] hover:bg-[#40a95c] transition-colors" href="#" onclick="openReservation(); return false;">{t.reserve}</a>
  </div>

  {/* Free items */}
  <h2 class="text-[24px] max-[768px]:text-[1.2rem] mt-5 mb-5 text-brand-black font-bold">{t.freeTitle}</h2>
  <div class="text-base leading-[1.6] text-brand-black">
    <ul class="flex flex-wrap justify-center gap-y-[6px] gap-x-[16px] my-2.5 p-0 list-none">
      {t.freeItems.map((item: string) => (
        <li class="m-0 leading-[1.4] text-[1rem] flex items-center">
          <span class="inline-block w-[0.45rem] h-[0.45rem] bg-[#2F6940] mr-[.5em] shrink-0"></span>{item}
        </li>
      ))}
    </ul>
  </div>

  {/* Pet policy */}
  <h2 class="text-[24px] max-[768px]:text-[1.2rem] mb-5 mt-10 text-brand-black font-bold">{t.petTitle}</h2>
  <p class="text-base max-[768px]:text-[1rem] leading-[1.6]" set:html={t.petText}></p>

</div>
