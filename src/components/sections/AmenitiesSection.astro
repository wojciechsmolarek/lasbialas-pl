---
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Ikony konturowe rysowane w kodzie (kolor bierze się z klasy text-… przy <svg>).
// Są ozdobne: obok każdej stoi podpis, więc mają aria-hidden.
const icons = {
  // dwa domki
  cottages: '<path d="M1.5 20.5h21"/><path d="M2.5 20.5v-9L7.5 7l5 4.5v9"/><path d="M6 20.5v-4h3v4"/><path d="M14.5 20.5v-6.5l3.75-3.5L22 14v6.5"/><path d="M17.25 20.5v-3h2v3"/>',
  // las nad jeziorem
  forest: '<path d="M9 2.5 4.5 9H7l-3.5 5H7l-3 4.5h10L11 14h3.5L11 9h2.5z"/><path d="M9 18.5V22"/><path d="M14.5 19.3c1 0 1.5-.7 2.5-.7s1.5.7 2.5.7 1.5-.7 2.5-.7"/><path d="M14.5 22c1 0 1.5-.7 2.5-.7s1.5.7 2.5.7 1.5-.7 2.5-.7"/>',
  // łóżko
  bed: '<path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8"/><path d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"/><path d="M12 4v6"/><path d="M2 17h20"/>',
  // 18+
  adults: '<circle cx="12" cy="12" r="10"/><text x="12" y="15.2" text-anchor="middle" font-size="8.5" font-weight="600" font-family="Arial, Helvetica, sans-serif" fill="currentColor" stroke="none">18+</text>',
  // sauna: cebrzyk z chochlą i para
  sauna: '<path d="M7 2.5c-.8.8.8 1.7 0 2.5s.8 1.7 0 2.5"/><path d="M10.5 2.5c-.8.8.8 1.7 0 2.5s.8 1.7 0 2.5"/><path d="M14 2.5c-.8.8.8 1.7 0 2.5s.8 1.7 0 2.5"/><path d="M3.5 11h14l-1.6 9.5H5.1z"/><path d="M4.1 14.5h12.8"/><path d="M17.5 13l3.6-3"/><circle cx="21.2" cy="9.2" r="1.3"/>',
  // jacuzzi: wanna z bąbelkami
  jacuzzi: '<path d="M2.5 12h19v2.5a5.5 5.5 0 0 1-5.5 5.5H8a5.5 5.5 0 0 1-5.5-5.5z"/><path d="M7 20l-1 2"/><path d="M17 20l1 2"/><circle cx="8" cy="8" r="1.3"/><circle cx="12.5" cy="5.5" r="1.7"/><circle cx="16.5" cy="8.5" r="1.1"/>',
  // rower
  bike: '<circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>',
  // Wi-Fi
  wifi: '<path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.86a10 10 0 0 1 14 0"/><path d="M8.5 16.43a5 5 0 0 1 7 0"/>',
  // telewizor
  tv: '<rect x="2" y="7" width="20" height="15" rx="2"/><path d="m17 2-5 5-5-5"/><path d="M10.5 12v5l4.2-2.5z"/>',
};

const amenities = [
  { icon: icons.cottages, text: t('amenity.cottages') },
  { icon: icons.forest, text: t('amenity.location') },
  { icon: icons.bed, text: t('amenity.bedrooms') },
  { icon: icons.adults, text: t('amenity.adults_only') },
  { icon: icons.sauna, text: t('amenity.sauna') },
  { icon: icons.jacuzzi, text: t('amenity.jacuzzi') },
  { icon: icons.bike, text: t('amenity.bikes') },
  { icon: icons.wifi, text: t('amenity.wifi') },
  { icon: icons.tv, text: t('amenity.netflix') },
];
---

<section class="w-full bg-[#F7F7F7] p-[10px] mb-5">
  <ul class="grid grid-cols-9 gap-[15px] max-w-[1280px] mx-auto text-[0.9rem] list-none m-0 p-0 max-[1023px]:grid-cols-3">
    {amenities.map((amenity) => (
      <li class="text-center">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="36"
          height="36"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-9 h-9 mt-2.5 inline-block text-[#2F6940]"
          set:html={amenity.icon}
        />
        <p class="mt-[5px]" set:html={amenity.text.replace(/\n/g, '<br/>')} />
      </li>
    ))}
  </ul>
</section>
