---
import { useTranslations } from '../../i18n/utils';
interface Props {
  lang: 'pl' | 'en' | 'de';
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<div class="flex justify-center items-center w-full aspect-[1920/300] bg-[#2F6940] bg-center bg-no-repeat mt-2.5 mb-5">
  <section class="text-center text-white">
    <h2
      class="text-center text-[2rem] font-semibold text-white mt-[30px] mb-[50px] max-[768px]:text-[1rem] max-[768px]:m-[10px] max-[768px]:leading-[1.4]"
      set:html={t('banner.year_round_cottages')}
    ></h2>
  </section>
</div>
