---
import { Picture } from 'astro:assets';
import w1 from '../../assets/foto/w1.webp';
import w2 from '../../assets/foto/w2.webp';
import w3 from '../../assets/foto/w3.webp';
import w4 from '../../assets/foto/w4.webp';
import w6 from '../../assets/foto/w6.webp';
import w7 from '../../assets/foto/w7.webp';
import w13 from '../../assets/foto/w13.webp';
import w15 from '../../assets/foto/w15.webp';
import w17 from '../../assets/foto/w17.webp';
import w18 from '../../assets/foto/w18.webp';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

const t = {
  pl: {
    title: 'Komfortowe, dobrze wyposażone wnętrza',
    intro: 'Każdy domek ma dwie sypialnie, salon z aneksem kuchennym i łazienkę. W każdym pomieszczeniu działa niezależne ogrzewanie z termostatem, dostępne przez cały rok, także w chłodniejsze letnie dni, a w upały sypialnie chłodzą wentylatory sufitowe. Na terenie całego obiektu jest szybkie, bezpłatne Wi-Fi.',
    bedrooms: {
      title: 'Sypialnie',
      intro: 'Sypialnie znajdują się po przeciwnych stronach domku, co zapewnia prywatność również przy pobycie dwóch par. W jednej z nich jest dodatkowo Smart TV z Netflixem. Na łóżkach czekają ręczniki, a w szafie szlafroki i ręczniki do sauny. Każda sypialnia ma:',
      items: ['podwójne łóżko 140 × 200 cm', 'wygodny materac o wysokości 26 cm', 'bawełnianą pościel', 'moskitiery w oknach', 'wentylator sufitowy sterowany pilotem', 'rolety zewnętrzne i zasłony'],
      images: [
        { src: w1, alt: 'Większa sypialnia z podwójnym łóżkiem', tip: 'Większa sypialnia z łóżkiem 140 × 200 cm i wentylatorem sufitowym.' },
        { src: w2, alt: 'Mniejsza sypialnia ze Smart TV', tip: 'Mniejsza sypialnia z łóżkiem 140 × 200 cm i Smart TV.' },
        { src: w6, alt: 'Termostat ogrzewania w domku', tip: 'Niezależne ogrzewanie z termostatem w każdym pomieszczeniu.' },
        { src: w4, alt: 'Mniejsza sypialnia z wentylatorem sufitowym', tip: 'Mniejsza sypialnia z wentylatorem sufitowym i Smart TV.' },
      ],
    },
    living: {
      title: 'Salon z aneksem kuchennym',
      intro: 'W salonie stoi stół do posiłków z sofą i dwoma tapicerowanymi krzesłami, przy którym wygodnie usiądą cztery osoby. Jest tu też Smart TV z Netflixem, biblioteczka i gry planszowe. Aneks kuchenny jest dobrze wyposażony: ma dużą lodówkę z zamrażalnikiem, zmywarkę i płytę indukcyjną. W aneksie są też:',
      items: ['komplet garnków i patelni', 'talerze i miseczki (po 6 szt.)', 'kubki i szklanki', 'kieliszki do wina i inne szkło', 'sztućce i noże kuchenne', 'podstawowe akcesoria kuchenne', 'czajnik, toster i zaparzacz do herbaty', 'ekspres Nespresso De\'Longhi', 'zestaw kapsułek na start', 'herbata, cukier, sól i pieprz', 'płyn do naczyń i tabletki do zmywarki', 'gąbki, ścierki i ręczniki kuchenne', 'ręczniki papierowe', 'środek do czyszczenia blatów'],
      images: [
        { src: w13, alt: 'Salon z aneksem kuchennym', tip: 'Przestronny salon z aneksem kuchennym.' },
        { src: w7, alt: 'Aneks kuchenny', tip: 'Aneks z lodówką, zmywarką i płytą indukcyjną.' },
        { src: w15, alt: 'Biblioteczka i gry planszowe w salonie', tip: 'Biblioteczka i gry planszowe.' },
        { src: w3, alt: 'Smart TV w salonie', tip: 'Smart TV z Netflixem.' },
      ],
    },
    bathroom: {
      title: 'Łazienka',
      intro: 'Nowoczesna łazienka z prysznicem walk-in i deszczownicą. Na miejscu są:',
      items: ['żel pod prysznic i szampon', 'mydło w płynie', 'papier toaletowy', 'suszarka do włosów', 'środki czystości', 'odkurzacz bezprzewodowy', 'suszarka na pranie'],
      images: [
        { src: w17, alt: 'Łazienka z prysznicem walk-in', tip: 'Przestronna łazienka z prysznicem walk-in.' },
        { src: w18, alt: 'Wyposażenie łazienki', tip: 'Ręczniki, kosmetyki i suszarka do włosów.' },
      ],
    },
    parking: {
      title: 'Bezpłatny parking',
      text: 'Przy każdym domku jest bezpłatne miejsce parkingowe. Teren jest ogrodzony i oświetlony, a każdy domek ma własną bramę wjazdową i furtkę.',
    },
    guide: {
      title: 'Przewodnik Las Biala\'s',
      text: 'Więcej szczegółów dotyczących wyposażenia, udogodnień i pobytu na miejscu znajdziesz w naszym <a href="{#guide}" target="_blank" class="text-brand-green underline">przewodniku</a>.',
      btn: 'Przewodnik',
    },
  },
  en: {
    title: 'Cosy, Well-Equipped Interiors',
    intro: 'Each cottage has two bedrooms, a living room with a kitchenette and a bathroom. Every room has its own heating with a thermostat, available all year round, even on cooler summer days, while ceiling fans keep the bedrooms cool in hot weather. Fast, free Wi-Fi covers the whole property.',
    bedrooms: {
      title: 'Bedrooms',
      intro: 'The bedrooms are on opposite sides of the cottage, which gives privacy even when two couples stay together. One of them also has a Smart TV with Netflix. Towels are laid out on the beds, and bathrobes and sauna towels are in the wardrobe. Each bedroom has:',
      items: ['a double bed, 140 × 200 cm', 'a comfortable 26 cm mattress', 'cotton bedding', 'mosquito screens on the windows', 'a remote-controlled ceiling fan', 'external blinds and curtains'],
      images: [
        { src: w1, alt: 'Larger bedroom with a double bed', tip: 'Larger bedroom with a 140 × 200 cm bed and a ceiling fan.' },
        { src: w2, alt: 'Smaller bedroom with a Smart TV', tip: 'Smaller bedroom with a 140 × 200 cm bed and a Smart TV.' },
        { src: w6, alt: 'Heating thermostat in the cottage', tip: 'Separate heating with a thermostat in every room.' },
        { src: w4, alt: 'Smaller bedroom with a ceiling fan', tip: 'Smaller bedroom with a ceiling fan and a Smart TV.' },
      ],
    },
    living: {
      title: 'Living Room with Kitchenette',
      intro: 'The living room has a dining table with a sofa and two upholstered chairs, seating four people comfortably. There is also a Smart TV with Netflix, a bookshelf and board games. The kitchenette is well equipped, with a large fridge-freezer, a dishwasher and an induction hob. It also has:',
      items: ['a set of pots and pans', 'plates and bowls (6 of each)', 'mugs and glasses', 'wine glasses and other glassware', 'cutlery and kitchen knives', 'basic kitchen utensils', 'a kettle, a toaster and a tea infuser', 'a Nespresso De\'Longhi coffee machine', 'a starter set of coffee capsules', 'tea, sugar, salt and pepper', 'washing-up liquid and dishwasher tablets', 'sponges, cloths and tea towels', 'paper towels', 'surface cleaner'],
      images: [
        { src: w13, alt: 'Living room with kitchenette', tip: 'Spacious living room with a kitchenette.' },
        { src: w7, alt: 'Kitchenette', tip: 'Kitchenette with a fridge, dishwasher and induction hob.' },
        { src: w15, alt: 'Bookshelf and board games in the living room', tip: 'Bookshelf and board games.' },
        { src: w3, alt: 'Smart TV in the living room', tip: 'Smart TV with Netflix.' },
      ],
    },
    bathroom: {
      title: 'Bathroom',
      intro: 'A modern bathroom with a walk-in shower and a rainfall shower head. It is supplied with:',
      items: ['shower gel and shampoo', 'liquid soap', 'toilet paper', 'a hair dryer', 'cleaning products', 'a cordless vacuum cleaner', 'a drying rack'],
      images: [
        { src: w17, alt: 'Bathroom with a walk-in shower', tip: 'Spacious bathroom with a walk-in shower.' },
        { src: w18, alt: 'Bathroom amenities', tip: 'Towels, toiletries and a hair dryer.' },
      ],
    },
    parking: {
      title: 'Free Parking',
      text: 'Free parking is available right by each cottage. The grounds are fenced and lit, and each cottage has its own driveway gate and garden gate.',
    },
    guide: {
      title: 'Guidebook LAS BIALA\'S',
      text: 'More details about the equipment, amenities and your stay can be found in our <a href="{#guide}" target="_blank" class="text-brand-green underline">guidebook</a>.',
      btn: 'Guidebook',
    },
  },
  de: {
    title: 'Gemütliche, gut ausgestattete Räume',
    intro: 'Jedes Ferienhaus hat zwei Schlafzimmer, ein Wohnzimmer mit Küchenzeile und ein Badezimmer. In jedem Raum gibt es eine eigene Heizung mit Thermostat, die das ganze Jahr über nutzbar ist, auch an kühleren Sommertagen. An heißen Tagen sorgen Deckenventilatoren in den Schlafzimmern für Abkühlung. Auf dem gesamten Gelände steht schnelles, kostenloses WLAN zur Verfügung.',
    bedrooms: {
      title: 'Schlafzimmer',
      intro: 'Die Schlafzimmer liegen an gegenüberliegenden Seiten des Hauses, was auch bei einem Aufenthalt von zwei Paaren für Privatsphäre sorgt. In einem der beiden gibt es zusätzlich einen Smart TV mit Netflix. Handtücher liegen auf den Betten bereit, Bademäntel und Saunatücher befinden sich im Kleiderschrank. Jedes Schlafzimmer hat:',
      items: ['ein Doppelbett, 140 × 200 cm', 'eine bequeme, 26 cm hohe Matratze', 'Bettwäsche aus Baumwolle', 'Insektenschutzgitter an den Fenstern', 'einen Deckenventilator mit Fernbedienung', 'Außenrollläden und Vorhänge'],
      images: [
        { src: w1, alt: 'Größeres Schlafzimmer mit Doppelbett', tip: 'Größeres Schlafzimmer mit Bett 140 × 200 cm und Deckenventilator.' },
        { src: w2, alt: 'Kleineres Schlafzimmer mit Smart TV', tip: 'Kleineres Schlafzimmer mit Bett 140 × 200 cm und Smart TV.' },
        { src: w6, alt: 'Heizungsthermostat im Ferienhaus', tip: 'Eigene Heizung mit Thermostat in jedem Raum.' },
        { src: w4, alt: 'Kleineres Schlafzimmer mit Deckenventilator', tip: 'Kleineres Schlafzimmer mit Deckenventilator und Smart TV.' },
      ],
    },
    living: {
      title: 'Wohnzimmer mit Küchenzeile',
      intro: 'Im Wohnzimmer steht ein Esstisch mit Sofa und zwei gepolsterten Stühlen, an dem vier Personen bequem Platz finden. Außerdem gibt es einen Smart TV mit Netflix, ein Bücherregal und Brettspiele. Die Küchenzeile ist gut ausgestattet, mit einem großen Kühlschrank mit Gefrierfach, einer Spülmaschine und einem Induktionskochfeld. Außerdem vorhanden:',
      items: ['Töpfe und Pfannen', 'Teller und Schalen (je 6 Stück)', 'Tassen und Gläser', 'Weingläser und weitere Gläser', 'Besteck und Küchenmesser', 'grundlegende Küchenutensilien', 'Wasserkocher, Toaster und Teesieb', 'Nespresso-Kaffeemaschine von De\'Longhi', 'ein Starterset Kaffeekapseln', 'Tee, Zucker, Salz und Pfeffer', 'Spülmittel und Spülmaschinentabs', 'Schwämme, Lappen und Geschirrtücher', 'Küchenrolle', 'Oberflächenreiniger'],
      images: [
        { src: w13, alt: 'Wohnzimmer mit Küchenzeile', tip: 'Geräumiges Wohnzimmer mit Küchenzeile.' },
        { src: w7, alt: 'Küchenzeile', tip: 'Küchenzeile mit Kühlschrank, Spülmaschine und Induktionskochfeld.' },
        { src: w15, alt: 'Bücherregal und Brettspiele im Wohnzimmer', tip: 'Bücherregal und Brettspiele.' },
        { src: w3, alt: 'Smart TV im Wohnzimmer', tip: 'Smart TV mit Netflix.' },
      ],
    },
    bathroom: {
      title: 'Badezimmer',
      intro: 'Modernes Badezimmer mit Walk-in-Dusche und Regenduschkopf. Vorhanden sind:',
      items: ['Duschgel und Shampoo', 'Flüssigseife', 'Toilettenpapier', 'Haartrockner', 'Reinigungsmittel', 'Akkustaubsauger', 'Wäscheständer'],
      images: [
        { src: w17, alt: 'Badezimmer mit Walk-in-Dusche', tip: 'Geräumiges Badezimmer mit Walk-in-Dusche.' },
        { src: w18, alt: 'Ausstattung im Badezimmer', tip: 'Handtücher, Pflegeprodukte und Haartrockner.' },
      ],
    },
    parking: {
      title: 'Kostenloser Parkplatz',
      text: 'Direkt an jedem Ferienhaus kann kostenlos geparkt werden. Das Gelände ist eingezäunt und beleuchtet, und jedes Haus hat ein eigenes Einfahrtstor und eine eigene Gartenpforte.',
    },
    guide: {
      title: 'Gästeführer LAS BIALA\'S',
      text: 'Weitere Details zur Ausstattung, zu den Annehmlichkeiten und zum Aufenthalt finden Sie in unserem <a href="{#guide}" target="_blank" class="text-brand-green underline">Gästeführer</a>.',
      btn: 'Gästeführer',
    },
  },
}[lang];

const guideHref = {
  pl: 'https://lasbialas.pl/info/#/na-miejscu/505',
  en: 'https://lasbialas.pl/info/en/#/on-site/505',
  de: 'https://lasbialas.pl/info/de/#/vor-ort/505',
}[lang];

const mainGuideHref = {
  pl: 'https://lasbialas.pl/info/',
  en: 'https://lasbialas.pl/info/en/',
  de: 'https://lasbialas.pl/info/de/',
}[lang];

const h3Class = 'text-[1.2rem] text-center mt-[40px] mb-[15px] font-semibold text-[#2c2c2c]';
const sectionTextClass = 'text-base leading-[1.6] text-brand-black';
const bulletUl = 'flex flex-wrap justify-center gap-y-[6px] gap-x-[16px] my-2.5 p-0 list-none';
const bulletLi = 'm-0 leading-[1.4] text-[1rem] flex items-center';
const bulletMarker = 'inline-block w-[0.45rem] h-[0.45rem] bg-[#2F6940] mr-[.5em] shrink-0';
const miniGrid = 'grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] justify-center gap-[3px] mt-[40px] mb-[30px] max-[1342px]:grid-cols-2';
const miniImg = 'max-w-full h-auto object-cover cursor-default transition-transform duration-200';
const tipClass = 'invisible opacity-0 w-[320px] bg-black/70 text-white text-center rounded-[5px] p-[5px] absolute top-1/2 left-1/2 -translate-x-1/2 translate-y-[65px] transition-opacity duration-300 font-[Arial] text-[14px] font-normal leading-[1.4] z-[1] pointer-events-none group-hover:visible group-hover:opacity-100 max-[768px]:hidden';
---

<div class="max-w-[73%] border border-[#ccc] rounded-[5px] py-[10px] px-[80px] mx-auto mb-5 bg-white text-base text-center max-[768px]:max-w-[96vw] max-[768px]:p-5 max-[768px]:my-[1px] max-[768px]:mb-5 max-[768px]:text-[0.6rem]">
  <h2 class="text-[24px] text-center mt-5 mb-5 text-brand-black font-bold">{t.title}</h2>
  <p class="text-base leading-[1.6]">{t.intro}</p>

  {/* Bedrooms */}
  <h3 class={h3Class}>{t.bedrooms.title}</h3>
  <div class={sectionTextClass}>
    <p>{t.bedrooms.intro}</p>
    <ul class={bulletUl}>
      {t.bedrooms.items.map((item: string) => (
        <li class={bulletLi}><span class={bulletMarker}></span>{item}</li>
      ))}
    </ul>
  </div>
  <div class={miniGrid}>
    {t.bedrooms.images.map((img: any) => (
      <div class="relative inline-block group">
        <Picture alt={img.alt} width={834} height={834} loading="lazy" src={img.src} formats={['avif', 'webp']} sizes="(max-width: 1342px) 50vw, 25vw" class={miniImg} />
        <span class={tipClass}>{img.tip}</span>
      </div>
    ))}
  </div>

  {/* Living Room */}
  <h3 class={h3Class}>{t.living.title}</h3>
  <div class={sectionTextClass}>
    <p set:html={t.living.intro.replace('{#guide}', guideHref)}></p>
    <ul class={bulletUl}>
      {t.living.items.map((item: string) => (
        <li class={bulletLi}><span class={bulletMarker}></span>{item}</li>
      ))}
    </ul>
  </div>
  <div class={miniGrid}>
    {t.living.images.map((img: any) => (
      <div class="relative inline-block group">
        <Picture alt={img.alt} width={834} height={834} loading="lazy" src={img.src} formats={['avif', 'webp']} sizes="(max-width: 1342px) 50vw, 25vw" class={miniImg} />
        <span class={tipClass}>{img.tip}</span>
      </div>
    ))}
  </div>

  {/* Bathroom */}
  <h3 class={h3Class}>{t.bathroom.title}</h3>
  <div class={sectionTextClass}>
    <p set:html={t.bathroom.intro}></p>
    <ul class={bulletUl}>
      {t.bathroom.items.map((item: string) => (
        <li class={bulletLi}><span class={bulletMarker}></span>{item}</li>
      ))}
    </ul>
  </div>
  <div class={miniGrid}>
    {t.bathroom.images.map((img: any) => (
      <div class="relative inline-block group">
        <Picture alt={img.alt} width={834} height={834} loading="lazy" src={img.src} formats={['avif', 'webp']} sizes="(max-width: 1342px) 50vw, 25vw" class={miniImg} />
        <span class={tipClass}>{img.tip}</span>
      </div>
    ))}
  </div>

  {/* Parking */}
  <h3 class={h3Class}>{t.parking.title}</h3>
  <div class={sectionTextClass}>
    <p>{t.parking.text}</p>
  </div>

  {/* Guide */}
  <h3 class={h3Class}>{t.guide.title}</h3>
  <div class={sectionTextClass}>
    <p set:html={t.guide.text.replace('{#guide}', mainGuideHref)}></p>
  </div>
  <div class="flex justify-center mt-[30px]">
    <a class="inline-flex justify-center items-center w-auto h-[46px] text-base font-normal text-white bg-[#B5550E] border-none text-center no-underline normal-case cursor-pointer mb-[30px] mt-[10px] px-[15px] rounded-[6px] hover:bg-[#c4621a] transition-colors" href={mainGuideHref} target="_blank" rel="noopener">{t.guide.btn}</a>
  </div>
</div>
