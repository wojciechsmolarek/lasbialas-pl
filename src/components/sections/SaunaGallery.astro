---
import { Picture } from 'astro:assets';
import lasbialasJacuzzi1 from '../../assets/foto/lasbialas-jacuzzi1.webp';
import sauna1 from '../../assets/foto/sauna1.webp';
import lasbialas1 from '../../assets/foto/lasbialas1.webp';
import sauna4 from '../../assets/foto/sauna4.webp';
import sauna5 from '../../assets/foto/sauna5.webp';
import lasbialasJacuzzi2 from '../../assets/foto/lasbialas-jacuzzi2.webp';
import sauna7 from '../../assets/foto/sauna7.webp';
import lasbialasJacuzzi3 from '../../assets/foto/lasbialas-jacuzzi3.webp';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

const images = [lasbialasJacuzzi1, sauna1, lasbialas1, sauna4, sauna5, lasbialasJacuzzi2, sauna7, lasbialasJacuzzi3];

const t = {
  pl: {
    alt: ['Prywatne jacuzzi w lesie przy domku','Sauna fińska w lesie przy domkach Las Biala\'s','Jacuzzi przy tarasie domku','Sauna z kolorowym podświetleniem','Sauna wśród sosen','Jacuzzi z podświetleniem LED','Wnętrze sauny z podświetleniem LED','Jacuzzi w ogrodzie przy domku'],
    tip: ['Prywatne jacuzzi przy domku, dostępne za dopłatą','Sauna fińska z balią, w cenie pobytu','Jacuzzi tuż przy tarasie domku','Kolorowe podświetlenie w saunie','Sauna wśród wysokich sosen','Jacuzzi z aeromasażem, podświetleniem LED i wodą podgrzewaną do 37–38°C','Wnętrze sauny fińskiej','Jacuzzi w ogrodzie przy domku'],
  },
  en: {
    alt: ['Private jacuzzi in the forest by the cottage','Finnish sauna in the forest at Las Biala\'s','Jacuzzi by the cottage terrace','Sauna with colourful lighting','Sauna among pine trees','Jacuzzi with LED lighting','Sauna interior with LED lighting','Jacuzzi in the garden by the cottage'],
    tip: ['Private jacuzzi by the cottage, available for an extra fee','Finnish sauna with a cold plunge tub, included in the stay','Jacuzzi right by the cottage terrace','Colourful lighting in the sauna','Sauna among tall pine trees','Jacuzzi with air massage, LED lighting and water heated to 37–38°C','Inside the Finnish sauna','Jacuzzi in the garden by the cottage'],
  },
  de: {
    alt: ['Privater Whirlpool im Wald am Ferienhaus','Finnische Sauna im Wald bei Las Biala\'s','Whirlpool an der Terrasse des Ferienhauses','Sauna mit farbiger Beleuchtung','Sauna zwischen Kiefern','Whirlpool mit LED-Beleuchtung','Innenraum der Sauna mit LED-Beleuchtung','Whirlpool im Garten am Ferienhaus'],
    tip: ['Privater Whirlpool am Ferienhaus, gegen Aufpreis','Finnische Sauna mit Kaltwasserbottich, im Preis inbegriffen','Whirlpool direkt an der Terrasse des Ferienhauses','Farbige Beleuchtung in der Sauna','Sauna zwischen hohen Kiefern','Whirlpool mit Luftmassage, LED-Beleuchtung und 37–38 °C warmem Wasser','Im Inneren der finnischen Sauna','Whirlpool im Garten am Ferienhaus'],
  },
}[lang];
---

<div class="grid grid-cols-4 gap-[3px] mt-2.5 mb-2.5 max-[1024px]:grid-cols-2">
  {[8,9,10,11,12,13,14,15].map((i, idx) => (
    <div class="relative inline-block group">
      <Picture src={images[idx]} alt={t.alt[idx]} width={834} height={470} formats={['avif', 'webp']} sizes="(max-width: 1024px) 50vw, 25vw" loading="lazy" decoding="async" onclick={`openImage(${i})`} class="block w-full h-auto object-cover cursor-pointer transition-transform duration-200" />
      <span class="invisible opacity-0 w-[320px] bg-black/70 text-white text-center rounded-[5px] p-[5px] absolute top-1/2 left-1/2 -translate-x-1/2 translate-y-[65px] transition-opacity duration-300 font-[Arial] text-[14px] font-normal leading-[1.4] z-[1] pointer-events-none group-hover:visible group-hover:opacity-100 max-[768px]:hidden">{t.tip[idx]}</span>
    </div>
  ))}
</div>
