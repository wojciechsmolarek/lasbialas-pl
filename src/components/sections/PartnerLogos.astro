---
import { Picture } from 'astro:assets';
import bookingLogo from '../../assets/images/booking_logo.webp';
import airbnbLogo from '../../assets/images/airbnb_logo.webp';
import alohaLogo from '../../assets/images/aloha_logo.webp';
import { platformRatings } from '../../data/platformRatings';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

const t = {
  pl: {
    title: 'Opinie gości znajdziesz również na:',
    reviewsOn: 'Opinie gości na',
    cottage: 'Domek',
  },
  en: {
    title: 'You can also read guest reviews on:',
    reviewsOn: 'Guest reviews on',
    cottage: 'Cottage',
  },
  de: {
    title: 'Gästebewertungen finden Sie auch auf:',
    reviewsOn: 'Gästebewertungen auf',
    cottage: 'Ferienhaus',
  },
}[lang];

// Format oceny: skala 5 → „★ 5,0 (43)”, skala 10 → „9,9/10 (32)”
const fmt = (n: number) => n.toFixed(1).replace('.', lang === 'en' ? '.' : ',');
const ratingText = (r: { rating: number; count: number; scale: number }) =>
  r.scale === 10 ? `${fmt(r.rating)}/10 (${r.count})` : `${fmt(r.rating)} (${r.count})`;
const showStar = (r: { scale: number }) => r.scale !== 10;

const googleHref = 'https://www.google.com/maps?cid=2914860482544137358';
const bookingHref = 'https://www.booking.com/hotel/pl/las-bialas-kameralne-domki-w-puszczy-noteckiej.html';
const airbnb1Href = 'https://www.airbnb.pl/h/lasbialas1';
const airbnb2Href = 'https://www.airbnb.pl/h/lasbialas2';
const alohaHref = 'https://alohacamp.com/pl/property/las-biala-3828';

const r = platformRatings;
const linkClass = 'flex items-center justify-center h-[48px]';
const ratingClass = 'text-[0.9rem] text-brand-black mt-1 whitespace-nowrap';
const subLinkClass = 'text-brand-black underline hover:text-brand-green transition-colors';
---
<section class="w-full bg-[#f2f2f2] p-5 mb-5">
  <p class="text-center text-[1rem] font-semibold text-brand-black mt-1 mb-4">{t.title}</p>
  <div class="flex flex-wrap justify-center items-start gap-x-[48px] gap-y-[20px] max-w-[1280px] mx-auto max-[768px]:gap-x-[28px]">
    <div class="flex flex-col items-center shrink-0">
      <a href={googleHref} target="_blank" rel="nofollow noopener noreferrer" aria-label={`${t.reviewsOn} Google`} class={`${linkClass} gap-2 no-underline`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        <span class="text-[1.6rem] font-semibold text-[#5f6368] leading-none">Google</span>
      </a>
      <span class={ratingClass}>{showStar(r.google) && <span class="text-[#FFB300]">★ </span>}{ratingText(r.google)}</span>
    </div>

    <div class="flex flex-col items-center shrink-0">
      <a href={bookingHref} target="_blank" rel="nofollow noopener noreferrer" aria-label={`${t.reviewsOn} Booking.com`} class={linkClass}>
        <Picture alt="" src={bookingLogo} width={172} height={40} formats={['avif', 'webp']} loading="lazy" decoding="async" class="block w-[172px] max-w-full h-auto object-contain" />
      </a>
      <span class={ratingClass}>{showStar(r.booking) && <span class="text-[#FFB300]">★ </span>}{ratingText(r.booking)}</span>
    </div>

    <div class="flex flex-col items-center shrink-0">
      <a href={airbnb1Href} target="_blank" rel="nofollow noopener noreferrer" aria-label={`${t.reviewsOn} Airbnb, ${t.cottage} 1`} class={linkClass}>
        <Picture alt="" src={airbnbLogo} width={194} height={45} formats={['avif', 'webp']} loading="lazy" decoding="async" class="block w-[194px] max-w-full h-auto object-contain" />
      </a>
      <div class="flex flex-wrap justify-center gap-x-4 gap-y-1 mt-1 text-[0.9rem]">
        <span class="whitespace-nowrap"><a href={airbnb1Href} target="_blank" rel="nofollow noopener noreferrer" class={subLinkClass}>{t.cottage} 1</a> <span class="text-[#FFB300]">★</span> {ratingText(r.airbnb1)}</span>
        <span class="whitespace-nowrap"><a href={airbnb2Href} target="_blank" rel="nofollow noopener noreferrer" class={subLinkClass}>{t.cottage} 2</a> <span class="text-[#FFB300]">★</span> {ratingText(r.airbnb2)}</span>
      </div>
    </div>

    <div class="flex flex-col items-center shrink-0">
      <a href={alohaHref} target="_blank" rel="nofollow noopener noreferrer" aria-label={`${t.reviewsOn} AlohaCamp`} class={linkClass}>
        <Picture alt="" src={alohaLogo} width={190} height={44} formats={['avif', 'webp']} loading="lazy" decoding="async" class="block w-[190px] max-w-full h-auto object-contain" />
      </a>
      <span class={ratingClass}>{showStar(r.alohacamp) && <span class="text-[#FFB300]">★ </span>}{ratingText(r.alohacamp)}</span>
    </div>
  </div>
</section>
