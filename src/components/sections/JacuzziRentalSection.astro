---
interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

const t = {
  pl: {
    title: 'Wynajem jacuzzi',
    intro: 'Wynajem jacuzzi jest opcjonalny i obejmuje <b>nieograniczone korzystanie przez cały pobyt</b>. Cena zależy od długości pobytu i liczby osób. Jacuzzi zamawia się razem z pobytem: w formularzu rezerwacji na stronie, zaznaczając tę opcję, albo podając tę informację przy rezerwacji mailowej, telefonicznej, SMS-em lub przez WhatsApp. Jacuzzi jest gotowe do korzystania od przyjazdu. W okresie dużych mrozów może być niedostępne, dlatego przy pobytach zimą jego dostępność potwierdzamy przed rezerwacją.',
    cols: ['Długość pobytu', 'Cena jacuzzi za pobyt (1–2 os.)'],
    rows: [
      ['2–3 doby', '480 zł'],
      ['4 doby', '580 zł'],
      ['5 dób', '670 zł'],
      ['każda kolejna doba (od 6.)', '+100 zł'],
    ],
    note: [
      'Ceny zawierają jednorazową opłatę <b>150 zł</b> za przygotowanie jacuzzi.',
      'Przy rezerwacji dla 3–4 osób dopłata wynosi <b>+60 zł</b> przy pobycie 2–3 dób i <b>+20 zł</b> za każdą kolejną dobę.',
    ],
  },
  en: {
    title: 'Jacuzzi rental',
    intro: 'The jacuzzi rental is optional and includes <b>unlimited use throughout your stay</b>. The price depends on the length of stay and the number of guests. The jacuzzi is ordered together with the stay: by selecting this option in the booking form on the website, or by mentioning it when booking by email, phone, text message or WhatsApp. It is ready for use from your arrival. During severe frosts it may be unavailable, so for winter stays we confirm availability before booking.',
    cols: ['Length of stay', 'Jacuzzi price per stay (1–2 guests)'],
    rows: [
      ['2–3 nights', '480 PLN'],
      ['4 nights', '580 PLN'],
      ['5 nights', '670 PLN'],
      ['each additional night (from the 6th)', '+100 PLN'],
    ],
    note: [
      'Prices include a one-time <b>150 PLN</b> jacuzzi preparation fee.',
      'For bookings for 3–4 guests, the surcharge is <b>+60 PLN</b> for a 2–3 night stay and <b>+20 PLN</b> for each additional night.',
    ],
  },
  de: {
    title: 'Whirlpool-Miete',
    intro: 'Die Miete des Whirlpools ist optional und umfasst die <b>unbegrenzte Nutzung während des gesamten Aufenthalts</b>. Der Preis hängt von der Aufenthaltsdauer und der Personenzahl ab. Der Whirlpool wird zusammen mit dem Aufenthalt bestellt: durch Auswahl dieser Option im Buchungsformular auf der Website oder durch einen entsprechenden Hinweis bei der Buchung per E-Mail, Telefon, SMS oder WhatsApp. Er ist ab der Anreise nutzungsbereit. Bei starkem Frost kann er nicht verfügbar sein, daher bestätigen wir die Verfügbarkeit für Aufenthalte im Winter vor der Buchung.',
    cols: ['Aufenthaltsdauer', 'Whirlpool-Preis pro Aufenthalt (1–2 Pers.)'],
    rows: [
      ['2–3 Nächte', '480 PLN'],
      ['4 Nächte', '580 PLN'],
      ['5 Nächte', '670 PLN'],
      ['jede weitere Nacht (ab der 6.)', '+100 PLN'],
    ],
    note: [
      'Die Preise enthalten eine einmalige Gebühr von <b>150 PLN</b> für die Vorbereitung des Whirlpools.',
      'Bei einer Buchung für 3–4 Personen beträgt der Aufpreis <b>+60 PLN</b> bei 2–3 Nächten und <b>+20 PLN</b> für jede weitere Nacht.',
    ],
  },
}[lang];

const tableClass = 'w-full max-w-[900px] border-collapse text-base max-[768px]:text-[1rem] my-[30px] mx-auto bg-[#f4f4f4] border-2 border-white text-center table-fixed';
const thClass = 'bg-[#362e27] text-white font-semibold px-[6px] py-[4px] h-[40px] border-2 border-white align-middle w-[50%] max-[768px]:text-[1rem] max-[768px]:leading-[1.2] max-[768px]:break-words max-[768px]:whitespace-normal';
const tdClass = 'h-[60px] p-[6px] border-2 border-white align-middle max-[768px]:text-[1rem] max-[768px]:h-[48px] max-[768px]:break-words';
---

<div class="max-w-[73%] border border-[#ccc] rounded-[5px] py-[10px] px-[80px] mx-auto mb-5 bg-white text-base text-center max-[768px]:max-w-[96vw] max-[768px]:p-5 max-[768px]:my-[1px] max-[768px]:mb-5 max-[768px]:text-[1rem]">
  <h2 class="text-[24px] max-[768px]:text-[1.2rem] mb-5 mt-5 text-brand-black font-bold" id="cennik-jacuzzi">{t.title}</h2>
  <p class="text-base max-[768px]:text-[1rem] leading-[1.6]" set:html={t.intro}></p>

  {/* Pricing table */}
  <table class={tableClass}>
    <thead>
      <tr>
        {t.cols.map((col: string) => (
          <th class={thClass} set:html={col}></th>
        ))}
      </tr>
    </thead>
    <tbody>
      {t.rows.map((row: string[]) => (
        <tr>
          {row.map((cell: string) => (
            <td class={tdClass} set:html={cell}></td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>

  {/* Notes */}
  <div class="max-w-[82%] max-[768px]:max-w-[98vw] border border-brand-green rounded-[5px] p-[5px] my-[5px] mx-auto mb-[30px] bg-white text-[1rem] max-[768px]:text-[1rem] text-brand-green text-center">
    {t.note.map((note: string) => (
      <p class="my-[5px]" set:html={note}></p>
    ))}
  </div>
</div>
