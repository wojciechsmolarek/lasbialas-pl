---
import { useTranslations } from '../../i18n/utils';
import { Picture } from 'astro:assets';
import domki4Osobowe from '../../assets/foto/domki-4-osobowe.png';
import domekWLesie from '../../assets/foto/domek-w-lesie.png';
import domekZ2Sypialniami from '../../assets/foto/domek-z-2-sypialniami.png';
import adults from '../../assets/foto/adults.png';
import saunaWLesie from '../../assets/foto/sauna-w-lesie.png';
import prywatneJacuzzi from '../../assets/foto/prywatne-jacuzzi.png';
import sport from '../../assets/foto/sport.png';
import bezplatneWifi from '../../assets/foto/bezplatne-wifi.png';
import netflix from '../../assets/foto/netflix.png';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Ikony są ozdobne: obok każdej stoi podpis, więc mają pusty alt
const amenities = [
  { icon: domki4Osobowe, text: t('amenity.cottages') },
  { icon: domekWLesie, text: t('amenity.location') },
  { icon: domekZ2Sypialniami, text: t('amenity.bedrooms') },
  { icon: adults, text: t('amenity.adults_only') },
  { icon: saunaWLesie, text: t('amenity.sauna') },
  { icon: prywatneJacuzzi, text: t('amenity.jacuzzi') },
  { icon: sport, text: t('amenity.bikes') },
  { icon: bezplatneWifi, text: t('amenity.wifi') },
  { icon: netflix, text: t('amenity.netflix') },
];
---

<section class="w-full bg-[#f2f2f2] p-[10px] mb-5">
  <ul class="grid grid-cols-9 gap-[15px] max-w-[1280px] mx-auto text-[0.9rem] list-none m-0 p-0 max-[1023px]:grid-cols-3">
    {amenities.map((amenity) => (
      <li class="text-center">
        <Picture
          alt=""
          src={amenity.icon}
          width={68}
          height={68}
          formats={['avif', 'webp']}
          class="w-[45px] h-[45px] mt-2.5 inline-block"
        />
        <p class="mt-[5px]" set:html={amenity.text.replace(/\n/g, '<br/>')} />
      </li>
    ))}
  </ul>
</section>
