---
import type { ImageMetadata } from 'astro';
import { useTranslations } from '../../i18n/utils';
import pergolaJacuzzi from '../../assets/foto/pergola_jacuzzi-1.webp';
import lasbialas6 from '../../assets/foto/lasbialas6.webp';
import lasbialas7 from '../../assets/foto/lasbialas7.webp';
import balia from '../../assets/foto/balia.jpg';
import saunaLed from '../../assets/foto/saunaled.webp';
import lasbialasJacuzzi3 from '../../assets/foto/lasbialas-jacuzzi3.webp';
import ImageHints from '../ui/ImageHints.astro';
import { imageHint, insertHint } from '../ui/imageHint';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Ikony konturowe rysowane w kodzie, te same rysunki co w pasku udogodnień (AmenitiesSection),
// tu białe, większe i z grubszą linią, bo stoją na ciemnym tle kart.
const icons = {
  sauna: '<path d="M7 2.5c-.8.8.8 1.7 0 2.5s.8 1.7 0 2.5"/><path d="M10.5 2.5c-.8.8.8 1.7 0 2.5s.8 1.7 0 2.5"/><path d="M14 2.5c-.8.8.8 1.7 0 2.5s.8 1.7 0 2.5"/><path d="M3.5 11h14l-1.6 9.5H5.1z"/><path d="M4.1 14.5h12.8"/><path d="M17.5 13l3.6-3"/><circle cx="21.2" cy="9.2" r="1.3"/>',
  jacuzzi: '<path d="M2.5 12h19v2.5a5.5 5.5 0 0 1-5.5 5.5H8a5.5 5.5 0 0 1-5.5-5.5z"/><path d="M7 20l-1 2"/><path d="M17 20l1 2"/><circle cx="8" cy="8" r="1.3"/><circle cx="12.5" cy="5.5" r="1.7"/><circle cx="16.5" cy="8.5" r="1.1"/>',
};
const svgAttrs = { 'aria-hidden': 'true', viewBox: '0 0 24 24', width: '64', height: '64', fill: 'none', stroke: 'currentColor', 'stroke-width': '1.6', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', class: 'inline-block w-16 h-16 text-white' };

const sectionTitle = {
  pl: 'Sauna i jacuzzi w Puszczy Noteckiej',
  en: 'Sauna and Jacuzzi in the Noteć Forest',
  de: 'Sauna und Whirlpool in der Puszcza Notecka',
}[lang];

const guideHref = {
  pl: 'https://lasbialas.pl/info/#/na-miejscu/32',
  en: 'https://lasbialas.pl/info/en/#/on-site/32',
  de: 'https://lasbialas.pl/info/de/#/vor-ort/32',
}[lang];

const jacuzziHref = {
  pl: 'https://lasbialas.pl/info/#/na-miejscu/385',
  en: 'https://lasbialas.pl/info/en/#/on-site/385',
  de: 'https://lasbialas.pl/info/de/#/vor-ort/385',
}[lang];

const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Wstawia w tekst słowa ze zdjęciami (dymki). Najpierw słowa zamieniamy na znaczniki,
// potem znaczniki na dymki, żeby opis zdjęcia (alt) jednego dymku nie był brany za słowo kolejnego.
// Jeśli któreś słowo zostanie zmienione w ui.ts, wyświetli się normalnie, bez zdjęcia.
type Hint = { word: string; image: ImageMetadata; alt: string };
async function applyHints(text: string, hints: Hint[], prefix: string): Promise<string> {
  let out = escapeHtml(text);
  hints.forEach((h, i) => { out = out.replace(h.word, `{${prefix}${i}}`); });
  for (const [i, h] of hints.entries()) {
    const html = await imageHint({ word: h.word, image: h.image, alt: h.alt, onDark: true });
    out = insertHint(out, `{${prefix}${i}}`, html);
  }
  return out;
}

// Opis sauny (tekst w ui.ts: section.sauna_desc).
const saunaHints: Hint[] = {
  pl: [
    { word: 'Sauna fińska', image: lasbialas7, alt: 'Wnętrze sauny fińskiej' },
    { word: 'oświetlenie LED', image: saunaLed, alt: 'Sauna z włączonym oświetleniem LED' },
    { word: 'strefę wypoczynku', image: lasbialas6, alt: 'Sauna z tarasem i strefą wypoczynku wśród sosen' },
    { word: 'balią', image: balia, alt: 'Drewniana balia z zimną wodą do schładzania' },
  ],
  en: [
    { word: 'Finnish sauna', image: lasbialas7, alt: 'Inside the Finnish sauna' },
    { word: 'LED lighting', image: saunaLed, alt: 'Sauna with the LED lighting switched on' },
    { word: 'seating area', image: lasbialas6, alt: 'Sauna with a terrace among the pine trees' },
    { word: 'tub of cold water', image: balia, alt: 'Wooden cold plunge tub' },
  ],
  de: [
    { word: 'finnische Sauna', image: lasbialas7, alt: 'Innenraum der finnischen Sauna' },
    { word: 'LED-Beleuchtung', image: saunaLed, alt: 'Sauna mit eingeschalteter LED-Beleuchtung' },
    { word: 'Sitzbereich', image: lasbialas6, alt: 'Sauna mit Terrasse zwischen Kiefern' },
    { word: 'Kaltwasserbottich', image: balia, alt: 'Hölzerner Kaltwasserbottich' },
  ],
}[lang];
const saunaDesc = await applyHints(t('section.sauna_desc'), saunaHints, 'saunaHint');

// Opis jacuzzi (tekst w ui.ts: section.jacuzzi_desc).
const jacuzziHints: Hint[] = {
  pl: [
    { word: 'prywatne jacuzzi', image: lasbialasJacuzzi3, alt: 'Prywatne jacuzzi na terenie domku' },
    { word: 'pergolą', image: pergolaJacuzzi, alt: 'Jacuzzi pod pergolą z regulowanym zadaszeniem i zasłonami' },
  ],
  en: [
    { word: 'private jacuzzi', image: lasbialasJacuzzi3, alt: 'Private jacuzzi on the cottage grounds' },
    { word: 'pergola', image: pergolaJacuzzi, alt: 'Jacuzzi under a pergola with an adjustable roof and curtains' },
  ],
  de: [
    { word: 'privater Whirlpool', image: lasbialasJacuzzi3, alt: 'Privater Whirlpool auf dem Grundstück' },
    { word: 'Pergola', image: pergolaJacuzzi, alt: 'Whirlpool unter einer Pergola mit verstellbarem Dach und Vorhängen' },
  ],
}[lang];
const jacuzziDesc = await applyHints(t('section.jacuzzi_desc'), jacuzziHints, 'jacuzziHint');

// Wpis na blogu jest tylko po polsku, więc link pokazujemy wyłącznie w wersji PL.
const saunaBlogLink = lang === 'pl'
  ? { href: '/blog/jak-bezpiecznie-schlodzic-sie-po-saunie-poradnik-krok-po-kroku/', label: 'Jak bezpiecznie schłodzić się po saunie? Poradnik na blogu' }
  : null;
---

<section id="sauna-jacuzzi" class="mx-auto my-[30px] max-w-[73%] max-[768px]:max-w-[96%]">
  <h2 class="text-[24px] max-[768px]:text-[1.2rem] text-center mt-5 mb-5 text-brand-black font-bold">{sectionTitle}</h2>

  <div class="flex justify-center gap-[10px] flex-wrap max-[768px]:gap-[20px]">
    <div class="flex flex-col flex-[1_1_48%] border border-[#ccc] rounded-[5px] p-5 text-white text-base text-center leading-[1.6] box-border bg-gradient-to-b from-[#6b6767c6] to-[#3c3939c6] max-[768px]:flex-[1_1_100%] max-[768px]:max-w-[96vw] max-[768px]:mb-5">
      <div class="text-center mb-[5px]">
        <svg {...svgAttrs} set:html={icons.sauna} />
      </div>
      <h3 class="text-center mt-[5px] mb-5 text-white text-[24px] font-bold">{t('section.sauna_title')}</h3>
      <p class="text-base leading-[1.6]" set:html={saunaDesc}></p>
      {saunaBlogLink && (
        <p class="text-base leading-[1.6] mt-4">
          <a href={saunaBlogLink.href} class="text-white underline hover:text-[#f3d9c4] transition-colors">{saunaBlogLink.label}</a>
        </p>
      )}
      <div class="flex justify-center mt-auto pt-[30px]">
        <a class="inline-flex justify-center items-center gap-1.5 h-[46px] w-full max-w-[320px] text-base font-medium text-white bg-transparent border border-white/80 text-center no-underline normal-case cursor-pointer mb-[30px] mt-[10px] px-[15px] rounded-[6px] hover:bg-white hover:text-[#2c2c2c] transition-colors" href={guideHref} target="_blank" rel="noopener" aria-label={t('button.sauna_rules')}>{t('button.rules')}<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg></a>
      </div>
    </div>

    <div class="flex flex-col flex-[1_1_48%] border border-[#ccc] rounded-[5px] p-5 text-white text-base text-center leading-[1.6] box-border bg-gradient-to-b from-[#3c9b55cc] to-[#2F6940] max-[768px]:flex-[1_1_100%] max-[768px]:max-w-[96vw] max-[768px]:mb-5">
      <div class="text-center mb-[5px]">
        <svg {...svgAttrs} set:html={icons.jacuzzi} />
      </div>
      <h3 class="text-center mt-[5px] mb-5 text-white text-[24px] font-bold">{t('section.jacuzzi_title')}</h3>
      <p class="text-base leading-[1.6]" set:html={jacuzziDesc}></p>
      <div class="flex justify-center mt-auto pt-[30px]">
        <a class="inline-flex justify-center items-center gap-1.5 h-[46px] w-full max-w-[320px] text-base font-medium text-white bg-transparent border border-white/80 text-center no-underline normal-case cursor-pointer mb-[30px] mt-[10px] px-[15px] rounded-[6px] hover:bg-white hover:text-[#2c2c2c] transition-colors" href={jacuzziHref} target="_blank" rel="noopener" aria-label={t('button.jacuzzi_rules')}>{t('button.rules')}<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg></a>
      </div>
    </div>
  </div>
</section>

<ImageHints />
