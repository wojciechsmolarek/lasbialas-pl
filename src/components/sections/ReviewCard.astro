---
import type { Review } from '../../data/reviewsData';

interface Props {
  review: Review;
  lang: 'pl' | 'en' | 'de';
}

const { review, lang } = Astro.props;

const translatedFrom = {
  pl: '',
  en: 'Translated from Polish',
  de: 'Aus dem Polnischen übersetzt',
}[lang];

const content = lang === 'en' ? review.content_en : lang === 'de' ? review.content_de : review.content;

const starsLabel = { pl: `Ocena: ${review.rating} z 5`, en: `Rating: ${review.rating} out of 5`, de: `Bewertung: ${review.rating} von 5` }[lang];
const fullStars = Math.round(review.rating);

const svg = (body: string) => 'data:image/svg+xml;base64,' + Buffer.from(`<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">${body}</svg>`).toString('base64');

const sourceIcon: Record<string, string> = {
  'Google': svg('<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>'),
  'Booking.com': svg('<circle cx="12" cy="12" r="10" fill="#003580"/><text x="12" y="16.5" font-family="Arial" font-size="12" font-weight="bold" fill="#fff" text-anchor="middle">B</text>'),
  'Airbnb': svg('<circle cx="12" cy="12" r="10" fill="#FF5A5F"/><text x="12" y="16.5" font-family="Arial" font-size="12" font-weight="bold" fill="#fff" text-anchor="middle">A</text>'),
  'AlohaCamp': svg('<circle cx="12" cy="12" r="10" fill="#F97316"/><path fill="#fff" d="M12 6l-1.5 3h3L12 6zm-3.5 5L7 14h3l-1.5-3zm7 0L14 14h3l-1.5-3zM12 14l-1.5 3h3L12 14z"/>'),
};
---

<article class="border border-[#e0e0e0] rounded-[5px] p-5 bg-[#fafafa] flex flex-col text-left h-full">
  <div class="flex items-center gap-[12px] mb-3">
    {review.avatarUrl ? (
      <img src={review.avatarUrl} alt="" width="48" height="48" class="rounded-full w-12 h-12 object-cover shrink-0" loading="lazy" onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex';" />
    ) : null}
    <div class={`w-12 h-12 rounded-full bg-brand-green text-white items-center justify-center text-[18px] font-bold shrink-0 ${review.avatarUrl ? 'hidden' : 'flex'}`} aria-hidden="true">
      {review.author.charAt(0).toUpperCase()}
    </div>
    <div class="flex flex-col min-w-0">
      <span class="font-semibold text-[1rem] text-brand-black truncate">{review.author}</span>
      {review.source && (
        <span class="flex items-center gap-[4px] text-[13px] text-[#666]">
          {sourceIcon[review.source] && <img src={sourceIcon[review.source]} alt="" width="14" height="14" class="inline-block" />}
          {review.source}
        </span>
      )}
    </div>
  </div>
  <div class="mb-2 text-[16px] leading-none" role="img" aria-label={starsLabel}>
    {[0, 1, 2, 3, 4].map((i) => <span class={i < fullStars ? 'text-[#FFB300]' : 'text-[#ccc]'} aria-hidden="true">★</span>)}
  </div>
  {content && <p class="text-[1rem] leading-[1.6] text-[#444] whitespace-pre-line">{content}</p>}
  {lang !== 'pl' && content && <p class="text-[12px] text-[#666] italic mt-2">{translatedFrom}</p>}
</article>
