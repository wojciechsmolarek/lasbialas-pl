---
import { reviews } from '../../data/reviewsData';
import PartnerLogos from './PartnerLogos.astro';

interface Props {
  lang: 'pl' | 'en' | 'de';
}

const { lang } = Astro.props;

const t = {
  pl: { title: 'Opinie naszych gości', allReviews: 'Zobacz wszystkie opinie', href: '/opinie/' },
  en: { title: 'What our guests say', allReviews: 'See all reviews', href: '/en/reviews/' },
  de: { title: 'Bewertungen unserer Gäste', allReviews: 'Alle Bewertungen ansehen', href: '/de/bewertungen/' },
}[lang];
---

<section id="opinie" class="max-w-[73%] border border-[#ccc] rounded-[5px] py-[10px] px-[80px] mx-auto mb-5 bg-white text-base text-center max-[768px]:max-w-[96vw] max-[768px]:p-5 max-[768px]:my-[1px] max-[768px]:mb-5 max-[768px]:text-[1rem]">
  <h2 class="text-[24px] text-center mt-5 mb-5 text-brand-black font-bold">{t.title}</h2>

  <PartnerLogos lang={lang} />

  <div class="flex justify-center mt-[20px]">
    <a href={t.href} class="inline-flex justify-center items-center h-[46px] px-[24px] text-base font-semibold text-white bg-brand-green no-underline rounded-[6px] hover:bg-brand-dark-green transition-colors mb-[30px]">{t.allReviews} ({reviews.length})</a>
  </div>
</section>
