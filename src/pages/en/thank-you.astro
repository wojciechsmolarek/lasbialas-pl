---
import PageLayout from '../../layouts/PageLayout.astro';
import ThankYouSection from '../../components/sections/ThankYouSection.astro';

const lang = 'en';
---

<!-- Strona podziękowania po płatności PayPal: wyłączona z indeksowania (noindex) -->
<PageLayout
  title="Thank you for your payment | Las Biala's"
  description="Thank you for your PayPal payment. We will email you the booking confirmation."
  lang={lang}
  noindex={true}
>
  <ThankYouSection lang={lang} />
</PageLayout>
